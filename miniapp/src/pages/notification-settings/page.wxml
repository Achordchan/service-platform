<import src="/components/states.wxml" />

<view class="page">
  <template wx:if="{{loading}}" is="skeleton-list" data="{{count: 2}}" />

  <template
    wx:elif="{{loadError}}"
    is="state-error"
    data="{{title: '加载失败', desc: loadError, retry: true}}"
  />

  <block wx:else>
    <view class="card">
      <view class="setting-row">
        <view>
          <view class="setting-title">站内通知</view>
          <view class="text-secondary">小程序消息中心与网页通知保持一致</view>
        </view>
      </view>
      <view class="setting-row">
        <view>
          <view class="setting-title">提示音</view>
          <view class="text-secondary">网页端收到通知时播放提示音</view>
        </view>
        <switch checked="{{soundEnabled}}" disabled="{{saving}}" bindchange="onToggleSound" color="#1677ff" />
      </view>
      <view class="setting-row">
        <view>
          <view class="setting-title">邮件通知</view>
          <view class="text-secondary">工单有新回复时发送邮件提醒</view>
        </view>
        <switch checked="{{emailEnabled}}" disabled="{{saving}}" bindchange="onToggleEmail" color="#1677ff" />
      </view>
    </view>

    <view class="card">
      <view class="setting-row wechat-head">
        <view class="setting-title">微信提醒</view>
        <view
          wx:if="{{wechatConfigured}}"
          class="wechat-status {{wechatAllSubscribed ? 'wechat-status-on' : (wechatMissingCount < wechatTemplates.length ? 'wechat-status-part' : 'wechat-status-off')}}"
        >
          {{wechatAllSubscribed ? '已全部开启' : (wechatMissingCount < wechatTemplates.length ? '部分开启' : '未开启')}}
        </view>
      </view>
      <view class="text-secondary wechat-desc">
        工单有新回复、状态变化和项目动态时，通过微信服务通知第一时间提醒你。
      </view>

      <block wx:if="{{wechatConfigured}}">
        <view class="wechat-template" wx:for="{{wechatTemplates}}" wx:key="templateKey">
          <view class="wechat-template-label">{{item.label}}</view>
          <view class="wechat-template-state {{item.subscribed ? 'on' : 'off'}}">
            <t-icon
              wx:if="{{item.subscribed}}"
              name="check-circle-filled"
              size="32rpx"
              color="#12b76a"
            />
            <text>{{item.subscribed ? (item.persistent ? '长期开启' : '已开启') : '未开启'}}</text>
          </view>
        </view>

        <view wx:if="{{wechatAllSubscribed}}" class="wechat-all-on">
          <t-icon name="check-circle-filled" size="36rpx" color="#12b76a" />
          <text>微信提醒已全部开启</text>
        </view>
        <button
          wx:else
          class="primary-btn"
          hover-class="hover-btn"
          loading="{{subscribing}}"
          bindtap="onSubscribeReminders"
        >
          {{wechatMissingCount < wechatTemplates.length ? '补充开启微信提醒' : '开启微信提醒'}}
        </button>

        <view
          wx:if="{{wechatAllSubscribed}}"
          class="wechat-reauth"
          hover-class="wechat-reauth-hover"
          bindtap="onSubscribeReminders"
        >再次授权</view>
        <view class="text-secondary wechat-hint">
          微信限制每次授权仅接收一条提醒，勾选「总是保持以上选择」可长期开启。
        </view>
      </block>

      <view wx:else class="text-secondary wechat-desc">
        微信订阅消息模板配置完成后即可开启提醒。
      </view>
    </view>
  </block>
</view>
