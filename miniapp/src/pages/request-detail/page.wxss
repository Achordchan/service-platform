.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

.hero {
  flex-shrink: 0;
  background: linear-gradient(180deg, #ffffff, var(--page-bg));
  border-bottom: 1rpx solid var(--divider);
  padding: 24rpx 28rpx;
}

.info-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-number {
  font-family: "SF Mono", Menlo, Consolas, monospace;
  color: var(--text-tertiary);
  font-size: 24rpx;
  letter-spacing: 0.5rpx;
}

.info-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-top: 8rpx;
  overflow-wrap: anywhere;
}

.info-grid {
  margin-top: 16rpx;
}

.info-item {
  display: flex;
  gap: 16rpx;
  padding: 6rpx 0;
  font-size: 26rpx;
}

.info-label {
  color: var(--text-tertiary);
  flex-shrink: 0;
  width: 110rpx;
}

.info-value {
  flex: 1;
}

.priority-HIGH { color: var(--warning); font-weight: 600; }
.priority-URGENT { color: var(--error); font-weight: 600; }

.chat-scroll {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 8rpx 28rpx 0;
}

.chat-empty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-tertiary);
  font-size: 25rpx;
}

.chat-bottom-spacer {
  height: 24rpx;
}

.msg-row {
  display: flex;
  margin: 18rpx 0;
  width: 100%;
  box-sizing: border-box;
}

.msg-mine {
  justify-content: flex-end;
}

.bubble {
  max-width: 74%;
  background: var(--card-bg);
  border: var(--card-border);
  box-shadow: var(--card-shadow);
  border-radius: 22rpx 22rpx 22rpx 8rpx;
  padding: 18rpx 22rpx;
}

.bubble-mine {
  background: linear-gradient(135deg, #e8f2ff, #dbeafe);
  border-color: rgba(22, 119, 255, 0.12);
  border-radius: 22rpx 22rpx 8rpx 22rpx;
}

.bubble-system {
  background: transparent;
  border: none;
  box-shadow: none;
  padding: 8rpx 0;
  max-width: 100%;
  text-align: center;
}

.system-text {
  color: var(--text-tertiary);
  font-size: 24rpx;
}

.msg-author {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-bottom: 8rpx;
}

.msg-admin-badge {
  display: inline-block;
  margin-left: 8rpx;
  padding: 0 10rpx;
  line-height: 30rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: #344054;
}

.reply-quote {
  border-left: 6rpx solid var(--brand);
  padding: 10rpx 16rpx;
  margin-bottom: 12rpx;
  background: var(--brand-soft);
  border-radius: 10rpx;
}

.reply-quote-label {
  font-size: 20rpx;
  color: var(--brand);
  font-weight: 600;
}

.reply-quote-body {
  font-size: 24rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.msg-body {
  font-size: 28rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.msg-files {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.msg-file {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  background: rgba(16, 24, 40, 0.04);
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
}

.msg-file-image .file-name {
  color: var(--brand);
  font-weight: 500;
}

.file-name {
  font-size: 26rpx;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-size {
  font-size: 22rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
}

/* 底部回复栏 */
.reply-bar {
  flex-shrink: 0;
  background: var(--card-bg);
  border-top: 1rpx solid var(--divider);
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}

.reply-target {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  background: var(--brand-soft);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: var(--brand);
}

.reply-target-main {
  flex: 1;
  min-width: 0;
}

.reply-target-preview {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.reply-target-cancel {
  flex-shrink: 0;
  padding: 0 8rpx;
  color: var(--text-secondary);
}

.reply-files {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.reply-file {
  font-size: 22rpx;
  background: rgba(16, 24, 40, 0.04);
  border-radius: 10rpx;
  padding: 10rpx 14rpx;
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.reply-file-remove {
  color: var(--error);
}

.reply-input-row {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
}

.reply-attach {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--page-bg);
  border-radius: 14rpx;
  flex-shrink: 0;
}

.reply-input {
  flex: 1;
  background: var(--page-bg);
  border-radius: 14rpx;
  /* 用 padding 垂直居中（textarea 的 line-height 对 placeholder 居中不可靠）；
     基础高度与两侧按钮一致，auto-height 多行时自然增高 */
  box-sizing: border-box;
  padding: 16rpx 22rpx;
  font-size: 28rpx;
  min-height: 76rpx;
  line-height: 44rpx;
  max-height: 220rpx;
}

.reply-placeholder {
  color: var(--text-tertiary);
  font-size: 28rpx;
  line-height: 44rpx;
}

/* 附件标题/备注小输入框只有 24rpx，默认 placeholder 32rpx 会明显大一圈 */
.reply-file-placeholder {
  color: var(--text-tertiary);
  font-size: 24rpx;
  line-height: 52rpx;
}

.send-btn {
  background: var(--brand) !important;
  color: #ffffff !important;
  border-radius: 14rpx !important;
  flex-shrink: 0;
  font-weight: 600;
  height: 76rpx !important;
  line-height: 76rpx !important;
  padding: 0 32rpx !important;
  min-width: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 风控撤回提示（对齐 Web：红色警告块 + 理由） */
.revoked-notice {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  color: var(--error);
}

.revoked-text {
  font-size: 24rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

/* 安全复查中提示 */
.reviewing-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* 输入区常置警示（对齐 Web ContentRiskNotice） */
.risk-notice {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.risk-notice-text {
  font-size: 21rpx;
  color: var(--text-tertiary);
  line-height: 1.6;
}

/* 附件标题 + 备注（消息内文件卡片） */
.file-main {
  flex: 1;
  min-width: 0;
}

.file-main .file-name {
  flex: none;
  display: block;
}

.file-note {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
  word-break: break-all;
}

/* 待发送附件：可预览、可改标题/加备注 */
.reply-file {
  display: block;
  width: 100%;
}

.reply-file-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.reply-file-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
}

.reply-file-preview {
  color: var(--brand, #1677ff);
  flex-shrink: 0;
}

.reply-file-input {
  box-sizing: border-box;
  margin-top: 8rpx;
  background: var(--card-bg, #fff);
  border: 2rpx solid rgba(16, 24, 40, 0.1);
  border-radius: 8rpx;
  /* 单行 input：固定高度 + 横向 padding，行高与 placeholder 对齐 */
  height: 56rpx;
  line-height: 52rpx;
  padding: 0 12rpx;
  font-size: 24rpx;
}

/* —— 员工（后台模式）扩展 —— */

/* 操作区：状态变更 / 指派 */
.staff-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.staff-action-btn {
  flex: 1;
  font-size: 26rpx;
}

/* 未分配认领提示 */
.claim-banner {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  background: #fef7e6;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #b45309;
}

/* 内部备注气泡与徽标（琥珀色系，区别于客户可见消息） */
.bubble-internal {
  background: #fffaf0;
  border: 2rpx dashed #f0c987;
}

.msg-internal-badge {
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  background: #fdf0d5;
  color: #b45309;
  font-size: 20rpx;
  border-radius: 6rpx;
}

/* 无权限只读提示 */
.reply-bar-notice {
  padding: 24rpx;
}

.staff-view-only {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 25rpx;
  color: var(--text-secondary, #667085);
}

/* 回复模式切换（回复客户 / 内部备注） */
.reply-mode-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.reply-mode-chip {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--text-secondary, #667085);
  background: rgba(16, 24, 40, 0.05);
}

.reply-mode-active {
  background: rgba(22, 119, 255, 0.12);
  color: #1677ff;
  font-weight: 500;
}

.reply-mode-internal-active {
  background: #fdf0d5;
  color: #b45309;
  font-weight: 500;
}

.reply-mode-hint {
  font-size: 22rpx;
  color: #b45309;
}

.reply-input-internal {
  background: #fffaf0;
}

/* 指派处理人面板 */
.assign-mask {
  position: fixed;
  inset: 0;
  background: rgba(16, 24, 40, 0.45);
  z-index: 20;
}

.assign-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 21;
  background: var(--card-bg, #fff);
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.assign-panel-title {
  font-size: 32rpx;
  font-weight: 600;
}

.assign-panel-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-tertiary, #98a2b3);
}

.assign-list {
  margin-top: 20rpx;
  max-height: 480rpx;
}

.assign-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 8rpx;
  border-bottom: 2rpx solid rgba(16, 24, 40, 0.06);
}

.assign-item-name {
  font-size: 28rpx;
}

.assign-item-role {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-tertiary, #98a2b3);
}

.assign-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--text-tertiary, #98a2b3);
}

.assign-panel-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.assign-cancel-btn {
  flex: 1;
}

.assign-confirm-btn {
  flex: 2;
}

/* 状态变更待确认：先看清会提醒谁，再确认 */
.status-pending {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: var(--page-bg);
}

.status-pending-title {
  font-size: 27rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.status-pending-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.status-pending-btn {
  flex: 1;
  margin: 0;
}

.reply-delivery {
  padding: 0 4rpx 6rpx;
}

/* 处理指南消息卡片：与普通文本气泡区分，明确「这不是全文」 */
.playbook-card {
  margin-top: 8rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(22, 119, 255, 0.06);
  border-left: 6rpx solid var(--brand);
}

.playbook-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.playbook-title {
  font-size: 28rpx;
  font-weight: 600;
}

.playbook-summary {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.playbook-more {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--brand);
}

/* 处理指南全文面板 */
.pb-mask {
  position: fixed;
  inset: 0;
  z-index: 900;
  background: rgba(16, 24, 40, 0.45);
  display: flex;
  align-items: flex-end;
}

.pb-panel {
  box-sizing: border-box;
  width: 100%;
  background: var(--card-bg);
  border-radius: 28rpx 28rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
}

.pb-panel-head {
  box-sizing: border-box;
  width: 100%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx;
}

.pb-panel-title {
  font-size: 32rpx;
  font-weight: 600;
}

.pb-panel-body {
  /* 与提醒方式面板同因：scroll-view 需要确定高度，且无全局 border-box 重置 */
  box-sizing: border-box;
  width: 100%;
  min-height: 240rpx;
  max-height: 60vh;
  padding: 0 28rpx 28rpx;
}

.pb-section-text {
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.pb-section-title {
  margin: 28rpx 0 12rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.pb-step {
  display: flex;
  gap: 14rpx;
  padding: 10rpx 0;
}

.pb-step-index {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
}

.pb-step-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.7;
}

.pb-note {
  padding: 12rpx 18rpx;
  margin-bottom: 10rpx;
  border-radius: 10rpx;
  background: rgba(247, 144, 9, 0.1);
  color: #b54708;
  font-size: 24rpx;
  line-height: 1.6;
}

/* 处理指南选择面板 */
.pb-filter {
  box-sizing: border-box;
  width: 100%;
  flex-shrink: 0;
  padding: 0 28rpx 12rpx;
}

.pb-search {
  box-sizing: border-box;
  width: 100%;
  height: 72rpx;
  line-height: 70rpx;
  padding: 0 20rpx;
  background: var(--page-bg);
  border-radius: 14rpx;
  font-size: 26rpx;
}

.pb-search-placeholder {
  color: var(--text-tertiary);
  font-size: 26rpx;
  line-height: 70rpx;
}

.pb-tabs {
  white-space: nowrap;
  margin-top: 16rpx;
}

.pb-tab {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: var(--page-bg);
  color: var(--text-secondary);
  font-size: 25rpx;
}

.pb-tab-active {
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 500;
}

.pb-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.pb-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(16, 24, 40, 0.06);
}

.pb-item-main {
  flex: 1;
  min-width: 0;
}

.pb-item-title {
  font-size: 28rpx;
  font-weight: 600;
}

.pb-item-summary {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.pb-item-preview {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--brand);
}

.pb-item-send {
  flex-shrink: 0;
  margin: 0;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 14rpx;
  background: var(--brand);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  border: none;
}

.pb-item-send::after {
  border: none;
}

/* 对方在线：文案不变，端用图标区分（手机=小程序，显示器=网页） */
.presence {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--success);
}

.presence-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--success);
}

.presence-text {
  font-size: 23rpx;
}
