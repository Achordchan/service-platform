<import src="/components/states.wxml" />

<view class="page">
  <template wx:if="{{loading}}" is="skeleton-list" data="{{count: 3}}" />

  <template
    wx:elif="{{loadError}}"
    is="state-error"
    data="{{title: loadErrorTitle, desc: loadError, retry: canRetry}}"
  />

  <block wx:elif="{{project}}">
    <view class="hero">
      <view class="head-row">
        <view class="head-title">{{project.title}}</view>
        <view class="tag tag-{{statusTone}}">{{statusLabel}}</view>
      </view>
      <view class="meta-grid">
        <view class="meta-item">
          <view class="meta-label">服务类型</view>
          <view class="meta-value">{{project.serviceType.name}}</view>
        </view>
        <view class="meta-item">
          <view class="meta-label">项目负责人</view>
          <view class="meta-value">
            {{project.staff.length > 0 ? project.staff[0].user.name : '待指派'}}
          </view>
        </view>
        <view class="meta-item">
          <view class="meta-label">所属客户</view>
          <view class="meta-value">{{project.customerSpace.name}}</view>
        </view>
        <view class="meta-item">
          <view class="meta-label">最近更新</view>
          <view class="meta-value">{{project.updatedAt}}</view>
        </view>
      </view>
      <view wx:if="{{project.showProgress !== false && project.progress > 0}}" class="progress-row">
        <view class="progress-track">
          <view class="progress-fill" style="width: {{project.progress}}%"></view>
        </view>
        <view class="progress-text">进度 {{project.progress}}%</view>
      </view>
    </view>

    <scroll-view scroll-x class="tab-bar" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab-item {{activeTab === item.key ? 'tab-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onSwitchTab"
      >
        {{item.label}}
      </view>
    </scroll-view>

    <!-- 概览 -->
    <block wx:if="{{activeTab === 'overview'}}">
      <view class="card">
        <view class="section-head">
          <view class="section-title">项目信息</view>
          <view wx:if="{{caps.canEditSettings}}" class="section-action" hover-class="hover-plain" bindtap="onOpenSettings">
            <t-icon name="setting-1" size="30rpx" color="#1677ff" /><text>设置</text>
          </view>
        </view>
        <view class="row {{caps.canManageDelivery ? 'row-editable' : ''}}" bindtap="onEditStage">
          <text class="row-label">当前阶段</text>
          <view class="row-value-edit">
            <text>{{project.currentStage || '—'}}</text>
            <t-icon wx:if="{{caps.canManageDelivery}}" name="edit-1" size="28rpx" color="#98a2b3" />
          </view>
        </view>
        <view class="row"><text class="row-label">服务周期</text><text>{{project.startDate || '—'}} 至 {{project.endDate || '—'}}</text></view>
        <view class="row"><text class="row-label">项目状态</text><text>{{statusLabel}}</text></view>
        <view wx:if="{{caps.canManageStaff}}" class="row row-editable" bindtap="onOpenStaff">
          <text class="row-label">项目人员</text>
          <view class="row-value-edit">
            <text>{{project.staff.length}} 人</text>
            <t-icon name="chevron-right" size="30rpx" color="#98a2b3" />
          </view>
        </view>
      </view>
      <view class="card stat-card">
        <view wx:if="{{showRequestStat}}" class="stat-item">
          <view class="stat-num">{{requestCount}}</view>
          <view class="stat-label">服务请求</view>
        </view>
        <view wx:if="{{showUpdateStat}}" class="stat-item">
          <view class="stat-num">{{project.updates.length}}</view>
          <view class="stat-label">项目动态</view>
        </view>
        <view wx:if="{{showMilestoneStat}}" class="stat-item">
          <view class="stat-num">{{project.milestones.length}}</view>
          <view class="stat-label">里程碑</view>
        </view>
      </view>
      <view wx:if="{{project.description}}" class="card">
        <view class="section-title">项目描述</view>
        <rich-text nodes="{{project.description}}"></rich-text>
      </view>
    </block>

    <!-- 里程碑：骨架先行 -->
    <block wx:if="{{activeTab === 'milestones'}}">
      <template wx:if="{{milestonesLoading}}" is="skeleton-list" data="{{count: 3}}" />
      <block wx:else>
        <template
          wx:if="{{milestones.length === 0}}"
          is="state-empty"
          data="{{icon: 'flag', title: '暂无里程碑', desc: '里程碑设置后会展示项目阶段'}}"
        />
        <block wx:else>
          <view
            wx:for="{{milestones}}"
            wx:key="id"
            class="card card-press"
            hover-class="hover-card"
            hover-stay-time="80"
            data-index="{{index}}"
            bindtap="onOpenMilestone"
          >
            <view class="update-head">
              <view class="update-title">{{item.title}}</view>
              <view class="tag tag-{{item.statusTone}}">{{item.statusLabel}}</view>
            </view>
            <view class="text-secondary update-meta">{{item.startDateText}} ~ {{item.endDateText}}</view>
            <view wx:if="{{item.descriptionText}}" class="update-preview">{{item.descriptionText}}</view>
            <view wx:else class="update-preview text-secondary">未填写说明</view>
            <view class="update-badges" wx:if="{{item.imageCount > 0 || item.attachmentCount > 0}}">
              <view wx:if="{{item.imageCount > 0}}" class="update-badge">{{item.imageCount}} 张图片</view>
              <view wx:if="{{item.attachmentCount > 0}}" class="update-badge">{{item.attachmentCount}} 个附件</view>
            </view>
            <view class="update-enter">查看全文<t-icon name="chevron-right" size="28rpx" color="#1677ff" /></view>
          </view>
        </block>
      </block>
    </block>

    <!-- 项目动态：骨架先行 + 摘要卡片（全文进详情页） -->
    <block wx:if="{{activeTab === 'updates'}}">
      <template wx:if="{{updatesLoading}}" is="skeleton-list" data="{{count: 3}}" />
      <template
        wx:elif="{{updates.length === 0}}"
        is="state-empty"
        data="{{icon: 'chat', title: '暂无项目动态', desc: '项目进展发布后会同步到这里'}}"
      />
      <block wx:else>
        <view
          wx:for="{{updates}}"
          wx:key="id"
          class="card card-press"
          hover-class="hover-card"
          hover-stay-time="80"
          data-index="{{index}}"
          bindtap="onOpenUpdate"
        >
          <view class="update-title">{{item.title}}</view>
          <view class="text-secondary update-meta">{{item.authorName}} · {{item.timeText}}</view>
          <view class="update-preview">{{item.bodyText}}</view>
          <view class="update-badges" wx:if="{{item.imageCount > 0 || item.commentCount > 0}}">
            <view wx:if="{{item.imageCount > 0}}" class="update-badge">{{item.imageCount}} 张图片</view>
            <view wx:if="{{item.commentCount > 0}}" class="update-badge">{{item.commentCount}} 条评论</view>
          </view>
          <view class="update-enter">查看全文<t-icon name="chevron-right" size="28rpx" color="#1677ff" /></view>
        </view>
      </block>
    </block>

    <!-- 服务请求：tab 内嵌该项目工单列表 -->
    <block wx:if="{{activeTab === 'requests'}}">
      <view class="request-actions">
        <view class="request-count text-secondary">共 {{requestCount}} 个服务请求</view>
      </view>
      <template wx:if="{{requestsLoading}}" is="skeleton-list" data="{{count: 3}}" />
      <template
        wx:elif="{{requests.length === 0}}"
        is="state-empty"
        data="{{icon: 'form', title: '暂无服务请求', desc: '有问题随时提交，我们会尽快处理'}}"
      />
      <block wx:else>
        <view
          wx:for="{{requests}}"
          wx:key="id"
          class="card card-press"
          hover-class="hover-card"
          hover-stay-time="80"
          data-id="{{item.id}}"
          bindtap="onOpenRequest"
        >
          <view class="req-head">
            <view class="req-number">{{item.number}}</view>
            <view class="tag tag-{{item.statusTone}}">{{item.statusLabel}}</view>
          </view>
          <view class="req-title">{{item.title}}</view>
          <view class="text-secondary req-meta">{{item.category.name}} · 更新于 {{item.updatedText}}</view>
        </view>
      </block>
    </block>

    <!-- 文件：项目级附件列表 -->
    <block wx:if="{{activeTab === 'files'}}">
      <template
        wx:if="{{files.length === 0}}"
        is="state-empty"
        data="{{icon: 'folder', title: '暂无项目文件', desc: '项目交付文件会展示在这里'}}"
      />
      <block wx:else>
        <view class="card">
          <view class="section-title">项目文件（{{files.length}}）</view>
          <view class="file-source-bar">
            <view
              wx:for="{{fileSourceOptions}}"
              wx:key="value"
              class="file-source-chip {{fileSource === item.value ? 'file-source-chip-active' : ''}}"
              data-value="{{item.value}}"
              bindtap="onFileSource"
            >{{item.label}}</view>
          </view>
          <view
            wx:for="{{files}}"
            wx:key="id"
            class="file-row"
            hover-class="hover-card"
            data-id="{{item.id}}"
            data-istext="{{item.isText}}"
            data-name="{{item.displayName}}"
            data-pinned="{{item.pinned}}"
            bindtap="onOpenFile"
            bindlongpress="onLongPressProjectFile"
          >
            <view class="file-ext">{{item.ext}}</view>
            <view class="file-main">
              <view class="file-name">{{item.displayName}}</view>
              <view wx:if="{{item.note}}" class="text-secondary file-sub file-note">{{item.note}}</view>
              <view class="text-secondary file-sub">
                {{item.sizeText}} · {{item.createdAt}}
                <text wx:if="{{item.pinned}}" class="file-source-tag">{{item.sourceLabel}}</text>
              </view>
            </view>
            <t-icon name="chevron-right" size="34rpx" color="#98a2b3" />
          </view>
        </view>
      </block>
    </block>

    <!-- 悬浮按钮会盖住列表末尾，留出等高的落地空间 -->
    <view wx:if="{{fabAction}}" class="fab-spacer"></view>
  </block>

  <!-- 当前阶段编辑 -->
  <view wx:if="{{stageVisible}}" class="stage-mask" bindtap="onCloseStage" catchtouchmove="noop">
    <view class="stage-panel" catchtap="noop">
      <view class="stage-title">当前阶段</view>
      <input
        class="stage-input"
        value="{{stageDraft}}"
        maxlength="60"
        placeholder="如：需求评审"
        placeholder-class="stage-placeholder"
        bindinput="onStageInput"
      />
      <view class="stage-hint">留空表示不展示阶段</view>
      <view class="stage-actions">
        <button class="plain-btn stage-btn" hover-class="hover-plain" bindtap="onCloseStage">取消</button>
        <button
          class="primary-btn stage-btn"
          hover-class="hover-btn"
          loading="{{stageSaving}}"
          disabled="{{stageSaving}}"
          bindtap="onSaveStage"
        >保存</button>
      </view>
    </view>
  </view>

  <!-- 右下角悬浮新增：动作跟随当前 tab（与工单列表的新建按钮同一套视觉） -->
  <view
    wx:if="{{fabAction}}"
    class="fab"
    hover-class="fab-hover"
    bindtap="onFabTap"
  >＋</view>
</view>
