.hero {
  background: linear-gradient(180deg, #ffffff, var(--page-bg));
  border-bottom: 1rpx solid var(--divider);
  padding: 28rpx 28rpx 24rpx;
}

.head-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.head-title {
  font-size: 36rpx;
  font-weight: 700;
  flex: 1;
  overflow-wrap: anywhere;
  letter-spacing: 0.5rpx;
}

.meta-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  gap: 16rpx 32rpx;
}

.meta-item {
  flex: 1 1 40%;
}

.meta-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.meta-value {
  font-size: 26rpx;
  margin-top: 4rpx;
  overflow-wrap: anywhere;
}

.progress-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
}

.progress-row .progress-track {
  flex: 1;
}

.tab-bar {
  /* 同 requests 的 .status-bar：content-box + 横向 padding 会溢出整页 */
  box-sizing: border-box;
  width: 100%;
  display: flex;
  white-space: nowrap;
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--divider);
  padding: 0 16rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  display: inline-block;
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
  transition: color 0.15s ease;
}

.tab-active {
  color: var(--brand);
  font-weight: 600;
}

.tab-active::after {
  content: "";
  position: absolute;
  left: 26rpx;
  right: 26rpx;
  bottom: 8rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--brand);
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  gap: 24rpx;
  font-size: 27rpx;
}

.row-label {
  color: var(--text-secondary);
  flex-shrink: 0;
}

.stat-card {
  display: flex;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--brand);
  font-variant-numeric: tabular-nums;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.update-title {
  font-weight: 650;
  font-size: 30rpx;
}

.update-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.update-body {
  margin-top: 14rpx;
  font-size: 27rpx;
  line-height: 1.7;
}

.expand-btn {
  margin-top: 10rpx;
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 500;
}

.comments {
  margin-top: 16rpx;
  border-top: 1rpx solid var(--divider);
  padding-top: 14rpx;
  background: var(--page-bg);
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
}

.comment {
  font-size: 24rpx;
  margin-top: 8rpx;
  line-height: 1.6;
}

.comment-author {
  color: var(--brand);
  margin-right: 12rpx;
  font-weight: 500;
}

.comment-body {
  color: var(--text-secondary);
}

.center-card {
  text-align: center;
  padding: 48rpx 32rpx;
}

.btn-block {
  margin-top: 20rpx;
}

/* 动态摘要卡片 */
.update-preview {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.update-badges {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.update-badge {
  font-size: 22rpx;
  color: var(--text-secondary);
  background: var(--page-bg);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.update-enter {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 14rpx;
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 500;
}

.update-chevron {
  transform: rotate(-45deg);
  margin-top: -4rpx;
}

/* 服务请求 tab：新建入口统一走右下角悬浮按钮，这里只留计数 */
.request-actions {
  padding: 12rpx 28rpx;
}

.req-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.req-number {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-family: "SF Mono", Menlo, Consolas, monospace;
}

.req-title {
  font-size: 29rpx;
  font-weight: 600;
  margin-top: 8rpx;
  overflow-wrap: anywhere;
}

.req-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
}

/* 文件列表 */
.file-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
}

.file-row + .file-row {
  border-top: 1rpx solid var(--divider);
}

.file-main {
  flex: 1;
  min-width: 0;
}

.file-sub {
  font-size: 22rpx;
  margin-top: 4rpx;
}

/* —— 交付写操作（员工/管理员）—— */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: #1677ff;
}

.row-editable {
  cursor: pointer;
}

.row-value-edit {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* 发布动态 / 新增里程碑 按钮 */
/* 右下角悬浮新增：与工单列表的新建按钮同一套视觉 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4096ff, var(--brand));
  color: #ffffff;
  font-size: 54rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(22, 119, 255, 0.35);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.fab-spacer {
  height: calc(180rpx + env(safe-area-inset-bottom));
}

.fab-hover {
  transform: scale(0.94);
  box-shadow: 0 6rpx 20rpx rgba(22, 119, 255, 0.3);
}

/* 当前阶段编辑面板 */
.stage-mask {
  position: fixed;
  inset: 0;
  z-index: 900;
  background: rgba(16, 24, 40, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}

.stage-panel {
  box-sizing: border-box;
  width: 100%;
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 36rpx 32rpx 28rpx;
}

.stage-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 28rpx;
}

/* 单行 input：固定高度 + 只留横向 padding + 显式同一行高（见 app.wxss 说明） */
.stage-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  background: var(--page-bg);
  border-radius: 14rpx;
  font-size: 30rpx;
}

.stage-placeholder {
  color: var(--text-tertiary);
  font-size: 30rpx;
  line-height: 88rpx;
}

.stage-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.stage-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.stage-btn {
  flex: 1;
  margin: 0;
}

/* 文件来源筛选 */
.file-source-bar {
  display: flex;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.file-source-chip {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: var(--page-bg);
  color: var(--text-secondary);
  font-size: 23rpx;
}

.file-source-chip-active {
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 500;
}

.file-source-tag {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 20rpx;
}


/* 里程碑标题与状态标签同排（与动态卡片同构） */
.update-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
