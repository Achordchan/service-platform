.hero {
  background: linear-gradient(180deg, #ffffff, var(--page-bg));
  border-bottom: 1rpx solid var(--divider);
  padding: 28rpx 28rpx 24rpx;
}

.head-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.head-title {
  font-size: 36rpx;
  font-weight: 700;
  flex: 1;
  overflow-wrap: anywhere;
  letter-spacing: 0.5rpx;
}

.meta-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  gap: 16rpx 32rpx;
}

.meta-item {
  flex: 1 1 40%;
}

.meta-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.meta-value {
  font-size: 26rpx;
  margin-top: 4rpx;
  overflow-wrap: anywhere;
}

.progress-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
}

.progress-row .progress-track {
  flex: 1;
}

.tab-bar {
  display: flex;
  white-space: nowrap;
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--divider);
  padding: 0 16rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  display: inline-block;
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
  transition: color 0.15s ease;
}

.tab-active {
  color: var(--brand);
  font-weight: 600;
}

.tab-active::after {
  content: "";
  position: absolute;
  left: 26rpx;
  right: 26rpx;
  bottom: 8rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--brand);
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  gap: 24rpx;
  font-size: 27rpx;
}

.row-label {
  color: var(--text-secondary);
  flex-shrink: 0;
}

.stat-card {
  display: flex;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--brand);
  font-variant-numeric: tabular-nums;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.timeline {
  padding: 8rpx 24rpx 40rpx;
}

.milestone-item {
  display: flex;
  gap: 20rpx;
}

.milestone-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.milestone-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  box-shadow: 0 0 0 6rpx var(--card-bg);
}

.ms-COMPLETED { background: var(--success); }
.ms-IN_PROGRESS { background: var(--brand); }
.ms-NOT_STARTED { background: rgba(16, 24, 40, 0.18); }

.milestone-line {
  width: 3rpx;
  flex: 1;
  background: var(--divider);
  margin: 6rpx 0;
}

.milestone-body {
  flex: 1;
  padding-bottom: 36rpx;
}

.milestone-title {
  font-weight: 600;
}

.milestone-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.update-title {
  font-weight: 650;
  font-size: 30rpx;
}

.update-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.update-body {
  margin-top: 14rpx;
  font-size: 27rpx;
  line-height: 1.7;
}

.expand-btn {
  margin-top: 10rpx;
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 500;
}

.comments {
  margin-top: 16rpx;
  border-top: 1rpx solid var(--divider);
  padding-top: 14rpx;
  background: var(--page-bg);
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
}

.comment {
  font-size: 24rpx;
  margin-top: 8rpx;
  line-height: 1.6;
}

.comment-author {
  color: var(--brand);
  margin-right: 12rpx;
  font-weight: 500;
}

.comment-body {
  color: var(--text-secondary);
}

.center-card {
  text-align: center;
  padding: 48rpx 32rpx;
}

.btn-block {
  margin-top: 20rpx;
}

/* 动态摘要卡片 */
.update-preview {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.update-badges {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.update-badge {
  font-size: 22rpx;
  color: var(--text-secondary);
  background: var(--page-bg);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.update-enter {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 14rpx;
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 500;
}

.update-chevron {
  transform: rotate(-45deg);
  margin-top: -4rpx;
}

/* 服务请求 tab */
.request-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 28rpx;
}

.new-request-btn {
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 600;
  padding: 10rpx 24rpx;
  background: var(--brand-soft);
  border-radius: 999rpx;
}

.req-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.req-number {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-family: "SF Mono", Menlo, Consolas, monospace;
}

.req-title {
  font-size: 29rpx;
  font-weight: 600;
  margin-top: 8rpx;
  overflow-wrap: anywhere;
}

.req-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
}

/* 文件列表 */
.file-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
}

.file-row + .file-row {
  border-top: 1rpx solid var(--divider);
}

.file-main {
  flex: 1;
  min-width: 0;
}

.file-sub {
  font-size: 22rpx;
  margin-top: 4rpx;
}
