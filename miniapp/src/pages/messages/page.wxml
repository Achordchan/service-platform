<import src="/components/states.wxml" />

<view class="page">
  <subscribe-banner />
  <view class="toolbar">
    <view class="unread-hint text-secondary">
      {{totalUnread > 0 ? totalUnread + ' 条未读' : '消息都是已读状态'}}
    </view>
    <view class="tool-link {{totalUnread > 0 ? '' : 'tool-link-muted'}}" hover-class="hover-plain" bindtap="onMarkAll">全部已读</view>
    <view class="tool-divider"></view>
    <view class="tool-link" hover-class="hover-plain" bindtap="onOpenSettings">通知设置</view>
  </view>

  <template wx:if="{{loading}}" is="skeleton-list" data="{{count: 5}}" />

  <template
    wx:elif="{{loadError}}"
    is="state-error"
    data="{{title: '加载失败', desc: loadError, retry: true}}"
  />

  <template
    wx:elif="{{items.length === 0}}"
    is="state-empty"
    data="{{icon: 'notification', title: '暂无消息', desc: '工单回复与项目动态会提醒到这里'}}"
  />

  <block wx:else>
    <!-- 一张卡内分隔的紧凑列表：一条消息一行，整行可点，不再逐条撑成独立卡片 -->
    <view class="notice-list">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="notice-row {{item.unread ? 'notice-row-unread' : ''}}"
        hover-class="hover-row"
        hover-stay-time="60"
        data-index="{{index}}"
        bindtap="onTapItem"
      >
        <view class="notice-flag">
          <view wx:if="{{item.unread}}" class="unread-dot"></view>
        </view>
        <view class="notice-main">
          <view class="notice-head">
            <view class="notice-title">{{item.title}}</view>
            <view wx:if="{{item.occurrenceCount > 1}}" class="notice-count">{{item.occurrenceCount}}</view>
            <view class="notice-time">{{item.timeText}}</view>
          </view>
          <view wx:if="{{item.body}}" class="notice-body">{{item.body}}</view>
        </view>
        <view class="notice-arrow">
          <t-icon name="chevron-right" size="30rpx" color="#c0c4cc" />
        </view>
      </view>
    </view>
    <view wx:if="{{loadingMore}}" class="load-more">加载中…</view>
    <view wx:elif="{{!nextCursor}}" class="load-more">没有更多了</view>
  </block>
</view>
