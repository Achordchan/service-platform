.toolbar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx 4rpx;
}

.unread-hint {
  flex: 1;
}

.tool-link {
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 500;
  padding: 8rpx 8rpx;
}

.tool-link-muted {
  color: var(--text-tertiary);
}

.tool-divider {
  width: 2rpx;
  height: 26rpx;
  background: var(--divider);
}

/* ———— 紧凑消息列表 ———— */
.notice-list {
  background: var(--card-bg);
  border-radius: var(--card-radius);
  border: var(--card-border);
  box-shadow: var(--card-shadow);
  margin: 16rpx 24rpx;
  overflow: hidden;
}

.notice-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx 24rpx;
}

/* 分隔线只画在行与行之间，首行不带线 */
.notice-row + .notice-row {
  border-top: 1rpx solid var(--divider);
}

.notice-row-unread {
  background: rgba(22, 119, 255, 0.04);
}

.hover-row {
  background: rgba(16, 24, 40, 0.04);
}

/* 未读点独占定宽列，保证已读/未读两种行的标题左边缘对齐 */
.notice-flag {
  width: 16rpx;
  flex-shrink: 0;
  padding-top: 14rpx;
}

.unread-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--error);
}

.notice-main {
  flex: 1;
  min-width: 0;
}

.notice-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.notice-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 40rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-row-unread .notice-title {
  font-weight: 600;
}

.notice-count {
  flex-shrink: 0;
  min-width: 30rpx;
  padding: 0 8rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
}

.notice-time {
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 40rpx;
  color: var(--text-tertiary);
}

.notice-body {
  margin-top: 2rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-arrow {
  flex-shrink: 0;
  align-self: center;
  display: flex;
}
