<import src="/components/states.wxml" />

<view class="page">
  <subscribe-banner />
  <view class="filter-bar">
    <picker
      class="project-picker"
      range="{{projects}}"
      range-key="title"
      value="{{projectIndex}}"
      bindchange="onProjectChange"
    >
      <view class="picker-value">
        {{projects.length > 0 ? projects[projectIndex].title : '全部项目'}}<t-icon name="caret-down" size="32rpx" color="#98a2b3" />
      </view>
    </picker>
    <input
      class="search-input"
      placeholder="搜索标题或工单号"
      placeholder-class="search-placeholder"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onKeywordInput"
      bindconfirm="onSearchConfirm"
    />
    <view class="filter-btn {{filterCount > 0 ? 'filter-btn-active' : ''}}" hover-class="hover-plain" bindtap="onOpenFilters">
      <t-icon name="filter" size="34rpx" color="{{filterCount > 0 ? '#1677ff' : '#667085'}}" />
      <text wx:if="{{filterCount > 0}}" class="filter-badge">{{filterCount}}</text>
    </view>
  </view>

  <scroll-view scroll-x class="status-bar" enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{statusOptions}}"
      wx:key="value"
      class="status-chip {{statusIndex === index ? 'status-chip-active' : ''}}"
      data-index="{{index}}"
      bindtap="onStatusTap"
    >
      {{item.label}}
    </view>
  </scroll-view>

  <template wx:if="{{loading}}" is="skeleton-list" data="{{count: 4}}" />

  <template
    wx:elif="{{loadError}}"
    is="state-error"
    data="{{title: '加载失败', desc: loadError, retry: true}}"
  />

  <template
    wx:elif="{{rows.length === 0}}"
    is="state-empty"
    data="{{icon: 'form', title: '暂无工单', desc: isStaff ? '当前筛选下没有工单' : '点击右下角 + 提交服务请求'}}"
  />

  <block wx:else>
    <view
      wx:for="{{rows}}"
      wx:key="id"
      class="card card-press request-card"
      hover-class="hover-card"
      hover-stay-time="80"
      data-id="{{item.id}}"
      bindtap="onOpenRequest"
    >
      <view class="request-head">
        <view class="request-number">{{item.number}}</view>
        <view class="tag tag-{{item.statusTone}}">{{item.statusLabel}}</view>
      </view>
      <view class="request-title">{{item.title}}</view>
      <view class="request-meta text-secondary">
        {{isStaff && item.projectTitle ? item.projectTitle + ' · ' : ''}}{{item.category.name}} · {{item.assignee ? '负责人 ' + item.assignee.name : '待指派'}}
      </view>
      <view class="request-meta text-secondary">更新于 {{item.updatedText}}</view>
    </view>
    <view wx:if="{{loadingMore}}" class="load-more">加载中…</view>
    <view wx:elif="{{!hasMore}}" class="load-more">没有更多了</view>
  </block>

  <view wx:if="{{!isStaff}}" class="fab" hover-class="fab-hover" bindtap="onNewRequest">＋</view>

  <!-- 更多筛选：优先级 / 归档范围 / 仅我处理 -->
  <view wx:if="{{filterVisible}}" class="filter-mask" bindtap="onCloseFilters" catchtouchmove="noop">
    <view class="filter-panel" catchtap="noop">
      <view class="filter-panel-head">
        <text class="filter-panel-title">更多筛选</text>
        <t-icon name="close" size="40rpx" color="#98a2b3" bindtap="onCloseFilters" />
      </view>

      <view class="filter-group-label">优先级</view>
      <view class="filter-chips">
        <view
          wx:for="{{priorityOptions}}"
          wx:key="value"
          class="filter-chip {{draftPriority === item.value ? 'filter-chip-active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onDraftPriority"
        >{{item.label}}</view>
      </view>

      <view class="filter-group-label">归档</view>
      <view class="filter-chips">
        <view
          wx:for="{{archivedOptions}}"
          wx:key="value"
          class="filter-chip {{draftArchived === item.value ? 'filter-chip-active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onDraftArchived"
        >{{item.label}}</view>
      </view>

      <view wx:if="{{isStaff}}" class="filter-switch-row">
        <view class="filter-group-label filter-group-inline">仅看分配给我的</view>
        <switch checked="{{draftAssignedToMe}}" color="#1677ff" bindchange="onDraftAssigned" />
      </view>

      <view class="filter-panel-foot">
        <button class="plain-btn filter-foot-btn" hover-class="hover-plain" bindtap="onResetFilters">重置</button>
        <button class="primary-btn filter-foot-btn" hover-class="hover-btn" bindtap="onApplyFilters">应用</button>
      </view>
    </view>
  </view>
</view>
