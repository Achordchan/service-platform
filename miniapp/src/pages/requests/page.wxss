.page {
  padding-bottom: 160rpx;
}

.filter-bar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx 12rpx;
  background: var(--page-bg);
}

.picker-value {
  background: var(--card-bg);
  border: var(--card-border);
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
  max-width: 260rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: flex;
  align-items: center;
}

.search-input {
  box-sizing: border-box;
  flex: 1;
  background: var(--card-bg);
  border: var(--card-border);
  border-radius: 14rpx;
  /* 单行 input：固定高度 + 横向 padding，行高与 placeholder 对齐 */
  height: 72rpx;
  line-height: 70rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.search-placeholder {
  color: var(--text-tertiary);
  font-size: 26rpx;
  line-height: 70rpx;
}

.status-bar {
  /* 项目无全局 border-box 重置：content-box 下横向 padding 会把 scroll-view
     自身撑到 100%+32rpx，整页因此能左右拖动（筛选条本身的溢出由内部横滚承担） */
  box-sizing: border-box;
  width: 100%;
  white-space: nowrap;
  padding: 8rpx 16rpx 16rpx;
}

.status-chip {
  display: inline-block;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--card-bg);
  border: var(--card-border);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  margin: 0 8rpx;
  transition: all 0.15s ease;
}

.status-chip-active {
  color: #ffffff;
  background: var(--brand);
  border-color: var(--brand);
  font-weight: 500;
}

.request-card {
  display: block;
}

.request-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.request-number {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-family: "SF Mono", Menlo, Consolas, monospace;
  letter-spacing: 0.5rpx;
}

.request-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 10rpx;
  overflow-wrap: anywhere;
}

.request-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4096ff, var(--brand));
  color: #ffffff;
  font-size: 54rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(22, 119, 255, 0.35);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.fab-hover {
  transform: scale(0.94);
  box-shadow: 0 6rpx 20rpx rgba(22, 119, 255, 0.3);
}

/* 更多筛选入口与面板 */
.filter-btn {
  position: relative;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  background: var(--card-bg);
  border: var(--card-border);
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-btn-active {
  border-color: var(--brand);
  background: var(--brand-soft);
}

.filter-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #ffffff;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
}

.filter-mask {
  position: fixed;
  inset: 0;
  z-index: 900;
  background: rgba(16, 24, 40, 0.45);
  display: flex;
  align-items: flex-end;
}

.filter-panel {
  box-sizing: border-box;
  width: 100%;
  background: var(--card-bg);
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
}

.filter-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.filter-panel-title {
  font-size: 32rpx;
  font-weight: 600;
}

.filter-group-label {
  margin: 24rpx 0 12rpx;
  font-size: 25rpx;
  color: var(--text-secondary);
}

.filter-group-inline {
  margin: 0;
  font-size: 28rpx;
  color: var(--text-primary);
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.filter-chip {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--page-bg);
  color: var(--text-secondary);
  font-size: 25rpx;
}

.filter-chip-active {
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 500;
}

.filter-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(16, 24, 40, 0.06);
}

.filter-panel-foot {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.filter-foot-btn {
  flex: 1;
  margin: 0;
}
