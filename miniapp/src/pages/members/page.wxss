.page {
  padding: 20rpx 0 60rpx;
}

.invite-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-top: 16rpx;
}

.invite-input {
  flex: 1;
  margin-bottom: 0;
}

.invite-btn {
  flex-shrink: 0;
}

.member-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
}

.member-row + .member-row {
  border-top: 1rpx solid var(--divider);
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name {
  font-size: 28rpx;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.owner-tag {
  font-size: 20rpx;
  color: var(--brand);
  background: rgba(22, 119, 255, 0.08);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin-left: 12rpx;
  font-weight: 400;
}

.bound-tag {
  font-size: 20rpx;
  color: var(--success);
  background: rgba(22, 164, 102, 0.1);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin-left: 12rpx;
  font-weight: 400;
}

.remove-btn {
  color: var(--error);
  font-size: 24rpx;
  flex-shrink: 0;
}

.retry-hint {
  margin-top: 12rpx;
  color: var(--brand);
}
