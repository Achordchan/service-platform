.detail-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.detail-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.detail-body {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.8;
}

.image-section {
  margin-top: 28rpx;
  border-top: 1rpx solid var(--divider);
  padding-top: 24rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.image-cell {
  width: 208rpx;
  height: 208rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: var(--page-bg);
}

.image-thumb {
  width: 100%;
  height: 100%;
}

.image-loading {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-skeleton {
  width: 100%;
  height: 100%;
  border-radius: 0;
}

.comment-item {
  padding: 16rpx 0;
}

.comment-item + .comment-item {
  border-top: 1rpx solid var(--divider);
}

.comment-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.comment-author {
  font-weight: 600;
  font-size: 26rpx;
  color: var(--brand);
}

.comment-time {
  font-size: 22rpx;
}

.comment-body {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.7;
}
