DATABASE_URL="postgresql://service_platform_app@localhost:5438/service_platform?schema=public"
DATABASE_MIGRATION_URL="postgresql://a1234@localhost:5438/service_platform?schema=public"
JOB_DATABASE_URL="postgresql://service_platform_jobs@localhost:5438/service_platform"

# Integration tests refuse non-test databases (name must end with _test).
# Put test-only URLs in .env.integration only (never copy main-library values from above).
#
# 1) createdb service_platform_test
# 2) create .env.integration with ALL THREE URLs pointing at the same host/port/*_test database:
# DATABASE_URL="postgresql://service_platform_app@localhost:5438/service_platform_test?schema=public"
# DATABASE_MIGRATION_URL="postgresql://a1234@localhost:5438/service_platform_test?schema=public"
# JOB_DATABASE_URL="postgresql://service_platform_jobs@localhost:5438/service_platform_test"
#
# 3) prepare + run ONLY through guarded scripts:
#    pnpm test:integration:prepare
#    pnpm test:integration
#
# prepare 会：只读 .env.integration → _test 门禁 → migrate deploy →
# GRANT service_platform_jobs CONNECT/CREATE → seed。
# Do NOT run bare `pnpm exec prisma migrate deploy` or `pnpm db:seed` for integration
# setup; those tools load the main .env / hard-coded service_platform fallback.
#
# Playwright E2E 同样只读 .env.e2e 或 .env.integration（同一 *_test 库），
# 可用 `cp .env.integration .env.e2e` 后补齐 BETTER_AUTH_* / APP_URL。
# 启动：pnpm test:e2e   # 固定启动 127.0.0.1:3000，禁止指向生产
# 本地默认启用内联邮件 Worker；生产有独立 systemd Worker 时必须设为 false
MAIL_INLINE_WORKER="true"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
# 以上 APP_URL / BETTER_AUTH_URL 仅作启动兜底；站点域名与邮件服务优先在后台「平台设置」维护
# 正式环境示例：
# BETTER_AUTH_URL="https://support.achord.cn"
# APP_URL="https://support.achord.cn"
UPLOAD_DIR=".data/uploads"
# 推荐设置独立主密钥。未设置时会从 BETTER_AUTH_SECRET 稳定派生兼容密钥。
# 生成：openssl rand -base64 32
PLATFORM_SECRET_ENCRYPTION_KEY=""
# 可选：仅作为后台设置未保存时的 SMTP 兜底，不建议日常依赖
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="服务支持中心 <info@achord.cn>"
# SMTP_SECURE="false"
