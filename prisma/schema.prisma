model Notification {
  id                                 String           @id @default(cuid())
  type                               NotificationType
  title                              String
  body                               String
  readAt                             DateTime?
  aggregationKey                     String?
  occurrenceCount                    Int              @default(1)
  emailDueAt                         DateTime?
  emailClaimedAt                     DateTime?
  emailLastSentOccurrenceCount       Int              @default(0)
  userId                             String
  customerSpaceId                    String?
  projectId                          String?
  serviceRequestId                   String?
  sourceType                         String?
  sourceId                           String?
  contentRiskReviewId                String?
  contentRiskEmailDueAt              DateTime?
  contentRiskReadAtBeforeSuppression DateTime?
  contentRiskBodyBeforeSuppression   String?
  contentRiskSuppressed              Boolean          @default(false)
  createdAt                          DateTime         @default(now())
  updatedAt                          DateTime         @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
