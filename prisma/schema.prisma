  result           String   @default("SUCCESS")
  metadata         Json?
  requestId        String?
  ipAddress        String?
  userAgent        String?
  actorId          String?
  externalActorId  String?
  customerSpaceId  String?
  projectId        String?
  serviceRequestId String?
