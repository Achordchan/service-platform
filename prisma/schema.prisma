// 微信小程序订阅消息投递（仿 DingTalkRobotDelivery 的 outbox 模式）。
// 只是提醒渠道：入队失败不影响业务，发送失败按 nextAttemptAt 重试，超限 FAILED。
model WechatSubscribeMessageDelivery {
  id            String    @id @default(cuid())
  eventKey      String    @unique
  templateKey   String
  userId        String
  requestId     String?
  title         String
  body          String
  page          String?
  status        String    @default("PENDING")
  attemptCount  Int       @default(0)
  nextAttemptAt DateTime?
  lastAttemptAt DateTime?
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
}

model UserNotificationPreference {
  id           String   @id @default(cuid())
  userId       String
  ruleKey      String
  emailEnabled Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ruleKey])
}

enum PresenceClient {
  WEB
  MINIAPP
}

model RequestPresence {
  id               String         @id @default(cuid())
  serviceRequestId String
  userId           String
  sessionId        String
  expiresAt        DateTime
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  /// 在线来自哪个端；仅用于在线标识旁的图标区分
  client           PresenceClient @default(WEB)
  /// 后台人员排查用：设备、时区、来源 IP。UA 与 IP 由服务端从请求头取，
  /// 不信客户端自报；时区只能由客户端提供（浏览器/小程序 API）。
  userAgent        String?
  timezone         String?
  ipAddress        String?

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serviceRequestId, userId, sessionId])
  @@index([serviceRequestId, expiresAt])
  @@index([userId, expiresAt])
}

model EventRecord {
  id               BigInt    @id @default(autoincrement())
