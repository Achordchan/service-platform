// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  CUSTOMER
  PROJECT_MANAGER
  TECHNICIAN
  PLATFORM_ADMIN
}

enum RoleAccessLevel {
  PROJECT_MANAGER
  TECHNICIAN
}

enum SpaceMemberRole {
  OWNER
  MEMBER
}

enum SpaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  EXPIRED
}

enum ProjectKind {
  STANDARD
  EXTERNAL_INTEGRATION
}

enum CustomerSpaceKind {
  STANDARD
  EXTERNAL_MANAGED
}

enum ProjectStaffRole {
  PROJECT_MANAGER
  TECHNICIAN
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum RequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ContentVisibility {
  CUSTOMER_VISIBLE
  INTERNAL
}

enum NotificationType {
  INVITATION
  PROJECT_UPDATE
  UPDATE_COMMENT
  PROJECT_STAGE
  PROJECT_MILESTONE
  PROJECT_FILE
  REQUEST_CREATED
  REQUEST_ASSIGNED
  REQUEST_MESSAGE
  REQUEST_STATUS
  REQUEST_ATTACHMENT
  REQUEST_ARCHIVE
}

enum EventType {
  PROJECT_UPDATED
  PROJECT_UPDATE_CREATED
  UPDATE_COMMENT_CREATED
  REQUEST_CREATED
  REQUEST_ASSIGNED
  REQUEST_MESSAGE_CREATED
  REQUEST_STATUS_CHANGED
  REQUEST_UPDATED
  REQUEST_PRESENCE_CHANGED
  PLUGIN_RUN_UPDATED
  NOTIFICATION_CREATED
}

enum MailDeliveryMode {
  LOCAL_OUTBOX
  RESEND
  SMTP
}

enum MailMessageStatus {
  QUEUED
  PROCESSING
  SENT
  DELIVERY_DELAYED
  DELIVERED
  BOUNCED
  COMPLAINED
  SUPPRESSED
  FAILED
  CANCELLED
}

enum UserEmailChangeStatus {
  PENDING
  COMPLETING
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PluginRunStatus {
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum PluginResourceStatus {
  PROCESSING
  COMPLETED
  SKIPPED
  FAILED
}

enum ProjectPluginBindingStatus {
  DRAFT
  ACTIVE
  DISABLED
  ARCHIVED
}

enum ExternalContactStatus {
  ACTIVE
  BLOCKED
}

enum UniversalWebhookDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum SupportPlaybookCategory {
  REMOTE
  DIAGNOSTIC
  INFORMATION
}

model User {
  id                      String            @id @default(cuid())
  name                    String
  email                   String            @unique
  emailVerified           Boolean           @default(false)
  image                   String?
  platformRole            PlatformRole      @default(CUSTOMER)
  phone                   String?
  company                 String?
  jobTitle                String?
  wechat                  String?
  website                 String?
  location                String?
  contactNotes            String?
  roleGroupId             String?
  soundNotificationsEnabled Boolean         @default(true)
  requestEmailNotificationsEnabled Boolean  @default(true)
  createdAt               DateTime          @default(now())
  platformSettingsUpdated PlatformSetting[] @relation("PlatformSettingUpdater")
  updatedAt               DateTime          @updatedAt

  roleGroup                  RoleGroup?             @relation(fields: [roleGroupId], references: [id], onDelete: SetNull)
  sessions                   Session[]
  accounts                   Account[]
  memberships                Membership[]
  ownedSpaces                CustomerSpace[]        @relation("SpaceOwner")
  invitationsCreated         Invitation[]           @relation("InvitationCreator")
  staffInvitationsCreated    StaffInvitation[]      @relation("StaffInvitationCreator")
  projectsCreated            Project[]              @relation("ProjectCreator")
  projectAssignments         ProjectStaff[]
  milestonesCreated          Milestone[]            @relation("MilestoneCreator")
  projectUpdates             ProjectUpdate[]
  updateComments             UpdateComment[]
  requestsCreated            ServiceRequest[]       @relation("RequestCreator")
  requestsAssigned           ServiceRequest[]       @relation("RequestAssignee")
  requestAssignees           RequestAssignee[]
  requestMessages            RequestMessage[]
  requestPresences           RequestPresence[]
  attachments                Attachment[]
  notifications              Notification[]
  auditLogs                  AuditLog[]
  mailTemplatesUpdated       MailTemplateOverride[]
  supportPlaybooksUpdated    SupportPlaybook[]      @relation("SupportPlaybookUpdater")
  notificationRulesUpdated  NotificationDeliveryRule[] @relation("NotificationDeliveryRuleUpdater")
  emailChanges               UserEmailChange[]      @relation("EmailChangeUser")
  emailChangesRequested      UserEmailChange[]      @relation("EmailChangeRequester")
  pluginInstallationsUpdated PluginInstallation[]   @relation("PluginInstallationUpdater")
  pluginRunsRequested        PluginRun[]            @relation("PluginRunRequester")

  @@index([roleGroupId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model CustomerSpace {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  kind        CustomerSpaceKind @default(STANDARD)
  memberLimit Int               @default(2)
  status      SpaceStatus       @default(ACTIVE)
  ownerId     String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  owner         User           @relation("SpaceOwner", fields: [ownerId], references: [id])
  memberships   Membership[]
  invitations   Invitation[]
  projects      Project[]
  attachments   Attachment[]
  notifications Notification[]
  auditLogs     AuditLog[]
  events        EventRecord[]

  @@index([ownerId])
  @@index([kind, status])
}

model Membership {
  id              String          @id @default(cuid())
  customerSpaceId String
  userId          String
  role            SpaceMemberRole @default(MEMBER)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  customerSpace CustomerSpace @relation(fields: [customerSpaceId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([customerSpaceId, userId])
  @@index([userId])
}

model Invitation {
  id              String          @id @default(cuid())
  email           String
  tokenHash       String          @unique
  role            SpaceMemberRole @default(MEMBER)
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  customerSpaceId String
  invitedById     String
  createdAt       DateTime        @default(now())

  customerSpace CustomerSpace @relation(fields: [customerSpaceId], references: [id], onDelete: Cascade)
  invitedBy     User          @relation("InvitationCreator", fields: [invitedById], references: [id])

  @@index([email])
  @@index([customerSpaceId])
}

model StaffInvitation {
  id           String       @id @default(cuid())
  email        String
  name         String?
  phone        String?
  company      String?
  jobTitle     String?
  wechat       String?
  website      String?
  location     String?
  contactNotes String?
  tokenHash    String       @unique
  platformRole PlatformRole
  roleGroupId  String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  invitedById  String
  createdAt    DateTime     @default(now())

  invitedBy User       @relation("StaffInvitationCreator", fields: [invitedById], references: [id])
  roleGroup RoleGroup? @relation(fields: [roleGroupId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([platformRole, createdAt])
  @@index([roleGroupId])
}

model RoleGroup {
  id          String          @id @default(cuid())
  key         String          @unique
  name        String
  description String?
  accessLevel RoleAccessLevel
  permissions String[]
  isSystem    Boolean         @default(false)
  active      Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  users       User[]
  invitations StaffInvitation[]

  @@index([active, sortOrder])
}

model ServiceType {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requestCategories RequestCategory[]
  projects          Project[]
}

model RequestCategory {
  id            String   @id @default(cuid())
  name          String
  description   String?
  active        Boolean  @default(true)
  serviceTypeId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  serviceType ServiceType      @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  requests    ServiceRequest[]

  @@unique([serviceTypeId, name])
}

model Project {
  id                      String        @id @default(cuid())
  title                   String
  description             String?
  status                  ProjectStatus @default(ACTIVE)
  kind                    ProjectKind   @default(STANDARD)
  currentStage            String?
  showMilestones          Boolean       @default(true)
  showProgress            Boolean       @default(true)
  customerUpdatesEnabled  Boolean       @default(true)
  customerRequestsEnabled Boolean       @default(true)
  customerFilesEnabled    Boolean       @default(true)
  startDate               DateTime?
  endDate                 DateTime?
  customerSpaceId         String
  serviceTypeId           String
  createdById             String
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  customerSpace  CustomerSpace          @relation(fields: [customerSpaceId], references: [id], onDelete: Cascade)
  serviceType    ServiceType            @relation(fields: [serviceTypeId], references: [id])
  createdBy      User                   @relation("ProjectCreator", fields: [createdById], references: [id])
  staff          ProjectStaff[]
  milestones     Milestone[]
  updates        ProjectUpdate[]
  requests       ServiceRequest[]
  attachments    Attachment[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  events         EventRecord[]
  pluginBindings ProjectPluginBinding[]

  @@index([customerSpaceId, status])
  @@index([serviceTypeId])
}

model ProjectStaff {
  id        String           @id @default(cuid())
  projectId String
  userId    String
  role      ProjectStaffRole
  createdAt DateTime         @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, role])
}

model Milestone {
  id          String          @id @default(cuid())
  title       String
  description String?
  status      MilestoneStatus @default(NOT_STARTED)
  startDate   DateTime?
  endDate     DateTime?
  sortOrder   Int             @default(0)
  projectId   String
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("MilestoneCreator", fields: [createdById], references: [id])
  attachments Attachment[]

  @@index([projectId, sortOrder])
}

model ProjectUpdate {
  id         String            @id @default(cuid())
  title      String
  body       String
  visibility ContentVisibility @default(CUSTOMER_VISIBLE)
  projectId  String
  authorId   String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User            @relation(fields: [authorId], references: [id])
  comments    UpdateComment[]
  attachments Attachment[]

  @@index([projectId, createdAt])
}

model UpdateComment {
  id              String            @id @default(cuid())
  body            String
  visibility      ContentVisibility @default(CUSTOMER_VISIBLE)
  projectUpdateId String
  authorId        String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  projectUpdate ProjectUpdate @relation(fields: [projectUpdateId], references: [id], onDelete: Cascade)
  author        User          @relation(fields: [authorId], references: [id])
  attachments   Attachment[]

  @@index([projectUpdateId, createdAt])
}

model ServiceRequest {
  id                         String          @id @default(cuid())
  number                     String          @unique
  title                      String
  description                String
  priority                   RequestPriority @default(NORMAL)
  status                     RequestStatus   @default(PENDING)
  projectId                  String
  categoryId                 String
  createdById                String?
  createdByExternalContactId String?
  assigneeId                 String?
  resolvedAt                 DateTime?
  closedAt                   DateTime?
  archivedAt                 DateTime?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  project                  Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category                 RequestCategory            @relation(fields: [categoryId], references: [id])
  createdBy                User?                      @relation("RequestCreator", fields: [createdById], references: [id])
  createdByExternalContact ExternalContact?           @relation("ExternalRequestCreator", fields: [createdByExternalContactId], references: [id])
  assignee                 User?                      @relation("RequestAssignee", fields: [assigneeId], references: [id])
  assignees                RequestAssignee[]
  messages                 RequestMessage[]
  presences                RequestPresence[]
  externalPresences        ExternalRequestPresence[]
  externalReadStates       ExternalRequestReadState[]
  attachments              Attachment[]
  notifications            Notification[]
  auditLogs                AuditLog[]
  events                   EventRecord[]
  dingTalkRobotDeliveries  DingTalkRobotDelivery[]

  @@index([projectId, status])
  @@index([projectId, archivedAt, status])
  @@index([assigneeId, status])
  @@index([status, resolvedAt])
  @@index([createdByExternalContactId, createdAt])
}

model RequestAssignee {
  id               String   @id @default(cuid())
  serviceRequestId String
  userId           String
  assignedAt       DateTime @default(now())
  assignedById     String?

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serviceRequestId, userId])
  @@index([userId])
  @@index([serviceRequestId])
}

model RequestMessage {
  id                      String            @id @default(cuid())
  body                    String
  visibility              ContentVisibility @default(CUSTOMER_VISIBLE)
  isSystem                Boolean           @default(false)
  isInitial               Boolean           @default(false)
  serviceRequestId        String
  authorId                String?
  externalAuthorId        String?
  replyToMessageId        String?
  supportPlaybookKey      String?
  supportPlaybookSnapshot Json?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  serviceRequest ServiceRequest   @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  author         User?            @relation(fields: [authorId], references: [id])
  externalAuthor ExternalContact? @relation(fields: [externalAuthorId], references: [id])
  replyTo        RequestMessage?  @relation("RequestMessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies        RequestMessage[] @relation("RequestMessageReplies")
  attachments    Attachment[]

  @@index([serviceRequestId, createdAt])
  @@index([replyToMessageId])
  @@index([externalAuthorId, createdAt])
}

model Attachment {
  id                          String            @id @default(cuid())
  originalName                String
  storageKey                  String            @unique
  mimeType                    String
  size                        Int
  visibility                  ContentVisibility @default(CUSTOMER_VISIBLE)
  inline                      Boolean           @default(false)
  customerSpaceId             String?
  projectId                   String?
  projectUpdateId             String?
  updateCommentId             String?
  milestoneId                 String?
  supportPlaybookKey          String?
  serviceRequestId            String?
  requestMessageId            String?
  uploadedById                String?
  uploadedByExternalContactId String?
  createdAt                   DateTime          @default(now())

  customerSpace             CustomerSpace?   @relation(fields: [customerSpaceId], references: [id], onDelete: Cascade)
  project                   Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectUpdate             ProjectUpdate?   @relation(fields: [projectUpdateId], references: [id], onDelete: Cascade)
  updateComment             UpdateComment?   @relation(fields: [updateCommentId], references: [id], onDelete: Cascade)
  milestone                 Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  supportPlaybook           SupportPlaybook? @relation(fields: [supportPlaybookKey], references: [key], onDelete: SetNull)
  serviceRequest            ServiceRequest?  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  requestMessage            RequestMessage?  @relation(fields: [requestMessageId], references: [id], onDelete: Cascade)
  uploadedBy                User?            @relation(fields: [uploadedById], references: [id])
  uploadedByExternalContact ExternalContact? @relation(fields: [uploadedByExternalContactId], references: [id])

  @@index([customerSpaceId, projectId])
  @@index([serviceRequestId])
  @@index([milestoneId])
  @@index([supportPlaybookKey])
  @@index([inline, createdAt])
  @@index([uploadedByExternalContactId, createdAt])
}

model Notification {
  id               String           @id @default(cuid())
  type             NotificationType
  title            String
  body             String
  readAt           DateTime?
  aggregationKey   String?
  occurrenceCount  Int              @default(1)
  emailDueAt       DateTime?
  emailClaimedAt   DateTime?
  emailLastSentOccurrenceCount Int   @default(0)
  userId           String
  customerSpaceId  String?
  projectId        String?
  serviceRequestId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerSpace  CustomerSpace?  @relation(fields: [customerSpaceId], references: [id], onDelete: Cascade)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  mailMessages    MailMessage[]

  @@unique([userId, aggregationKey])
  @@index([userId, readAt, createdAt])
  @@index([emailDueAt, readAt])
}

model NotificationDeliveryRule {
  key                 String   @id
  notificationEnabled Boolean @default(true)
  soundEnabled         Boolean @default(true)
  emailEnabled         Boolean @default(false)
  dingtalkEnabled      Boolean @default(false)
  updatedAt            DateTime @updatedAt
  updatedById          String?
  updatedBy            User?   @relation("NotificationDeliveryRuleUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedAt])
}

model RequestPresence {
  id               String   @id @default(cuid())
  serviceRequestId String
  userId           String
  sessionId        String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serviceRequestId, userId, sessionId])
  @@index([serviceRequestId, expiresAt])
  @@index([userId, expiresAt])
}

model EventRecord {
  id               BigInt    @id @default(autoincrement())
  type             EventType
  payload          Json
  userId           String?
  customerSpaceId  String?
  projectId        String?
  serviceRequestId String?
  createdAt        DateTime  @default(now())

  customerSpace  CustomerSpace?  @relation(fields: [customerSpaceId], references: [id], onDelete: Cascade)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([userId, id])
  @@index([customerSpaceId, id])
}

model AuditLog {
  id               BigInt   @id @default(autoincrement())
  action           String
  resourceType     String
  resourceId       String?
  result           String   @default("SUCCESS")
  metadata         Json?
  requestId        String?
  ipAddress        String?
  userAgent        String?
  actorId          String?
  externalActorId  String?
  customerSpaceId  String?
  projectId        String?
  serviceRequestId String?
  createdAt        DateTime @default(now())

  actor          User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  externalActor  ExternalContact? @relation(fields: [externalActorId], references: [id], onDelete: SetNull)
  customerSpace  CustomerSpace?   @relation(fields: [customerSpaceId], references: [id], onDelete: SetNull)
  project        Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  serviceRequest ServiceRequest?  @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([externalActorId, createdAt])
  @@index([customerSpaceId, createdAt])
}

model PlatformSetting {
  id                              Int              @id @default(1)
  appUrl                          String?
  mailFrom                        String           @default("服务支持中心 <no-reply@mail.achord.cn>")
  mailReplyTo                     String           @default("")
  resendApiKeyEncrypted           String?
  resendDomain                    String           @default("mail.achord.cn")
  resendDomainId                  String?
  resendDomainStatus              String?
  resendDnsRecords                Json?
  resendWebhookId                 String?
  resendWebhookStatus             String?
  resendWebhookSecretEncrypted    String?
  resendLastCheckedAt             DateTime?
  smtpHost                        String?
  smtpPort                        Int?
  smtpUser                        String?
  smtpPassword                    String?
  smtpPasswordEncrypted           String?
  smtpFrom                        String?
  smtpSecure                      Boolean          @default(false)
  smtpSecureConfigured            Boolean          @default(false)
  smtpHealthStatus                String?
  smtpLastCheckedAt               DateTime?
  smtpLastError                   String?
  mailMode                        MailDeliveryMode @default(LOCAL_OUTBOX)
  attachmentMaxSizeMb             Int              @default(20)
  attachmentAllowedExtensions     String           @default("jpg,jpeg,png,gif,webp,pdf,docx,xlsx,pptx,txt,log,csv,json")
  customerReplyAttachmentsEnabled Boolean          @default(true)
  standardRequestEmailEnabled     Boolean          @default(false)
  updatedAt                       DateTime         @updatedAt
  updatedById                     String?
  updatedBy                       User?            @relation("PlatformSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

model UserEmailChange {
  id            String                @id @default(cuid())
  userId        String
  oldEmail      String
  newEmail      String
  tokenHash     String                @unique
  status        UserEmailChangeStatus @default(PENDING)
  expiresAt     DateTime
  lastSentAt    DateTime
  completedAt   DateTime?
  cancelledAt   DateTime?
  requestedById String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  user        User  @relation("EmailChangeUser", fields: [userId], references: [id], onDelete: Cascade)
  requestedBy User? @relation("EmailChangeRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([newEmail, status])
  @@index([expiresAt, status])
}

model PluginInstallation {
  key           String    @id
  version       String
  enabled       Boolean   @default(false)
  config        Json
  secretConfigEncrypted   String?
  healthConfigFingerprint String?
  healthStatus  String    @default("UNKNOWN")
  lastCheckedAt DateTime?
  lastError     String?
  updatedAt     DateTime  @updatedAt
  updatedById   String?

  updatedBy       User?                  @relation("PluginInstallationUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  runs            PluginRun[]
  resourceStates  PluginResourceState[]
  projectBindings ProjectPluginBinding[]
}

model DingTalkRobotDelivery {
  id            String         @id
  eventKey      String         @unique
  eventType     String
  requestId     String
  payload       Json
  status        String         @default("PENDING")
  attemptCount  Int            @default(0)
  nextAttemptAt DateTime?
  lastAttemptAt DateTime?
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  request       ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([requestId, createdAt])
}

model ProjectPluginBinding {
  id                    String                     @id @default(cuid())
  projectId             String
  pluginKey             String
  externalConnectorSlot String?
  publicId              String                     @unique @default(cuid())
  status                ProjectPluginBindingStatus @default(DRAFT)
  config                Json                       @default("{}")
  archivedAt            DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  project             Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plugin              PluginInstallation            @relation(fields: [pluginKey], references: [key], onDelete: Restrict)
  sub2ApiConnection   Sub2ApiConnection?
  universalConnection UniversalConnectorConnection?
  externalContacts    ExternalContact[]
  embedSessions       ExternalEmbedSession[]

  @@unique([projectId, pluginKey])
  @@unique([projectId, externalConnectorSlot])
  @@index([pluginKey, status])
  @@index([projectId, status])
}

model Sub2ApiConnection {
  bindingId                          String    @id
  baseUrl                            String
  sourceOrigin                       String
  adminApiKeyEncrypted               String?
  emailNotificationsEnabled          Boolean   @default(true)
  customerMemberNotificationsEnabled Boolean   @default(false)
  healthStatus                       String    @default("UNKNOWN")
  lastCheckedAt                      DateTime?
  lastError                          String?
  createdAt                          DateTime  @default(now())
  updatedAt                          DateTime  @updatedAt

  binding ProjectPluginBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)
}

model UniversalConnectorConnection {
  bindingId                          String    @id
  name                               String
  allowedOrigins                     Json      @default("[]")
  profileFields                      Json      @default("[]")
  emailNotificationsEnabled          Boolean   @default(true)
  customerMemberNotificationsEnabled Boolean   @default(false)
  webhookUrl                         String?
  webhookSecretEncrypted             String?
  webhookEvents                      Json      @default("[]")
  webhookStatus                      String    @default("DISABLED")
  healthStatus                       String    @default("UNKNOWN")
  lastCheckedAt                      DateTime?
  lastError                          String?
  createdAt                          DateTime  @default(now())
  updatedAt                          DateTime  @updatedAt

  binding           ProjectPluginBinding           @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  credentials       UniversalConnectorCredential[]
  launchTickets     UniversalLaunchTicket[]
  webhookDeliveries UniversalWebhookDelivery[]
}

model UniversalConnectorCredential {
  id           String    @id @default(cuid())
  bindingId    String
  clientId     String    @unique
  secretHash   String
  secretPrefix String
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  connection UniversalConnectorConnection @relation(fields: [bindingId], references: [bindingId], onDelete: Cascade)

  @@index([bindingId, revokedAt, createdAt])
}

model UniversalLaunchTicket {
  id             String    @id @default(cuid())
  bindingId      String
  ticketHash     String    @unique
  externalUserId String
  profile        Json
  context        Json      @default("{}")
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  connection UniversalConnectorConnection @relation(fields: [bindingId], references: [bindingId], onDelete: Cascade)

  @@index([bindingId, externalUserId, createdAt])
  @@index([bindingId, createdAt])
  @@index([expiresAt, consumedAt])
}

model UniversalWebhookDelivery {
  id             String                         @id @default(cuid())
  bindingId      String
  eventId        String                         @unique
  eventType      String
  payload        Json
  status         UniversalWebhookDeliveryStatus @default(PENDING)
  attemptCount   Int                            @default(0)
  nextAttemptAt  DateTime?
  lastAttemptAt  DateTime?
  responseStatus Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  connection UniversalConnectorConnection @relation(fields: [bindingId], references: [bindingId], onDelete: Cascade)

  @@index([bindingId, status, createdAt])
  @@index([status, nextAttemptAt])
}

model ExternalContact {
  id                String                @id @default(cuid())
  bindingId         String
  externalUserId    String
  email             String?
  username          String?
  displayName       String
  avatarUrl         String?
  profileAttributes Json                  @default("{}")
  lastParentOrigin  String?
  status            ExternalContactStatus @default(ACTIVE)
  firstSeenAt       DateTime              @default(now())
  lastSeenAt        DateTime              @default(now())
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  binding           ProjectPluginBinding       @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  embedSessions     ExternalEmbedSession[]
  requestsCreated   ServiceRequest[]           @relation("ExternalRequestCreator")
  requestMessages   RequestMessage[]
  attachments       Attachment[]
  requestPresences  ExternalRequestPresence[]
  requestReadStates ExternalRequestReadState[]
  auditLogs         AuditLog[]

  @@unique([bindingId, externalUserId])
  @@index([bindingId, status, lastSeenAt])
  @@index([email])
}

model ExternalEmbedSession {
  id                String    @id @default(cuid())
  tokenHash         String    @unique
  externalContactId String
  bindingId         String
  expiresAt         DateTime
  revokedAt         DateTime?
  lastSeenAt        DateTime  @default(now())
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())

  externalContact ExternalContact      @relation(fields: [externalContactId], references: [id], onDelete: Cascade)
  binding         ProjectPluginBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@index([externalContactId, expiresAt])
  @@index([bindingId, revokedAt, expiresAt])
}

model ExternalRequestPresence {
  id                String   @id @default(cuid())
  serviceRequestId  String
  externalContactId String
  sessionId         String
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  serviceRequest  ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  externalContact ExternalContact @relation(fields: [externalContactId], references: [id], onDelete: Cascade)

  @@unique([serviceRequestId, externalContactId, sessionId])
  @@index([serviceRequestId, expiresAt])
  @@index([externalContactId, expiresAt])
}

model ExternalRequestReadState {
  id                String    @id @default(cuid())
  serviceRequestId  String
  externalContactId String
  unreadCount       Int       @default(0)
  lastReadAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  serviceRequest  ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  externalContact ExternalContact @relation(fields: [externalContactId], references: [id], onDelete: Cascade)

  @@unique([serviceRequestId, externalContactId])
  @@index([externalContactId, unreadCount, updatedAt])
}

model PluginRun {
  id             String          @id @default(cuid())
  pluginKey      String
  kind           String
  status         PluginRunStatus @default(QUEUED)
  executionToken String?
  totalCount     Int             @default(0)
  processedCount Int             @default(0)
  successCount   Int             @default(0)
  skippedCount   Int             @default(0)
  failedCount    Int             @default(0)
  sourceBytes    BigInt          @default(0)
  outputBytes    BigInt          @default(0)
  savedBytes     BigInt          @default(0)
  cursor         String?
  lastError      String?
  requestedById  String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  plugin      PluginInstallation @relation(fields: [pluginKey], references: [key], onDelete: Cascade)
  requestedBy User?              @relation("PluginRunRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([pluginKey, status, createdAt])
}

model PluginResourceState {
  pluginKey        String
  resourceType     String
  resourceId       String
  status           PluginResourceStatus
  inputFingerprint String
  metadata         Json?
  lastError        String?
  processedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  plugin PluginInstallation @relation(fields: [pluginKey], references: [key], onDelete: Cascade)

  @@id([pluginKey, resourceType, resourceId])
  @@index([pluginKey, status, updatedAt])
}

model MailMessage {
  id             String              @id @default(cuid())
  toEmail        String
  templateKey    String?
  subject        String
  previewText    String?
  heading        String
  body           String
  actionLabel    String?
  actionUrl      String?
  sendAfter      DateTime            @default(now())
  idempotencyKey String?             @unique
  notificationId String?
  notificationOccurrenceCount Int?
  sourceType     String?
  sourceId       String?
  deliveryMode   MailDeliveryMode    @default(LOCAL_OUTBOX)
  status         MailMessageStatus   @default(QUEUED)
  attemptCount   Int                 @default(0)
  lastAttemptAt  DateTime?
  errorMessage   String?
  providerId     String?
  sentAt         DateTime?
  lastEventAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  providerEvents MailProviderEvent[]
  notification   Notification?       @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([status, sendAfter])
  @@index([toEmail, createdAt])
  @@index([providerId])
  @@index([notificationId, notificationOccurrenceCount])
  @@index([sourceType, sourceId, createdAt])
}

model MailTemplateOverride {
  key         String   @id
  subject     String
  previewText String
  heading     String
  body        String
  actionLabel String?
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedAt])
}

model SupportPlaybook {
  key          String                  @id @default(cuid())
  category     SupportPlaybookCategory
  title        String
  summary      String
  introduction String
  content      String?
  steps        Json
  safetyNotes  Json
  active       Boolean                 @default(true)
  sortOrder    Int                     @default(0)
  isBuiltin    Boolean                 @default(false)
  deletedAt    DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  updatedById  String?
  updatedBy    User?                   @relation("SupportPlaybookUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  attachments  Attachment[]

  @@index([deletedAt, active, sortOrder, title])
  @@index([updatedAt])
}

model MailProviderEvent {
  id                String       @id @default(cuid())
  providerEventId   String       @unique
  providerMessageId String?
  eventType         String
  detail            String?
  occurredAt        DateTime
  mailMessageId     String?
  createdAt         DateTime     @default(now())
  mailMessage       MailMessage? @relation(fields: [mailMessageId], references: [id], onDelete: SetNull)

  @@index([providerMessageId, occurredAt])
  @@index([mailMessageId, occurredAt])
}
