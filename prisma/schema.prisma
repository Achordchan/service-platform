  tokenHash         String    @unique
  externalContactId String
  bindingId         String
  expiresAt         DateTime
  revokedAt         DateTime?
  lastSeenAt        DateTime  @default(now())
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())

  externalContact ExternalContact      @relation(fields: [externalContactId], references: [id], onDelete: Cascade)
  binding         ProjectPluginBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@index([externalContactId, expiresAt])
  @@index([bindingId, revokedAt, expiresAt])
}

model ExternalRequestPresence {
  id                String   @id @default(cuid())
  serviceRequestId  String
  externalContactId String
  /// 外部门户前端生成的每标签页临时 id（crypto.randomUUID），只用于区分并发标签页
  sessionId         String
  /// 真正的 ExternalEmbedSession.id，由已鉴权的会话写入。
  /// IP 与 UA 记在会话上，「客户设备与网络」按这一列去连；
  /// 不能拿上面的 sessionId 连 —— 那是前端随机数，跟会话表没有任何关系。
  embedSessionId    String?
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  serviceRequest  ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  externalContact ExternalContact @relation(fields: [externalContactId], references: [id], onDelete: Cascade)

  @@unique([serviceRequestId, externalContactId, sessionId])
  @@index([serviceRequestId, expiresAt])
  @@index([externalContactId, expiresAt])
  @@index([embedSessionId])
}

model ExternalRequestReadState {
