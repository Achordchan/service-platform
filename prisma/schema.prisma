// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  CUSTOMER
  PROJECT_MANAGER
  TECHNICIAN
  PLATFORM_ADMIN
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum RoleAccessLevel {
  PROJECT_MANAGER
  TECHNICIAN
}

enum SpaceMemberRole {
  OWNER
  MEMBER
}

enum SpaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  EXPIRED
}

enum ProjectKind {
  STANDARD
  EXTERNAL_INTEGRATION
}

enum CustomerSpaceKind {
  STANDARD
  EXTERNAL_MANAGED
}

enum ProjectStaffRole {
  PROJECT_MANAGER
  TECHNICIAN
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum RequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ContentVisibility {
  CUSTOMER_VISIBLE
  INTERNAL
}

enum NotificationType {
  INVITATION
  PROJECT_CREATED
  PROJECT_UPDATE
  UPDATE_COMMENT
  PROJECT_STAGE
  PROJECT_STAFF
  PROJECT_MILESTONE
  PROJECT_FILE
  REQUEST_CREATED
  REQUEST_ASSIGNED
  REQUEST_CLAIMED
  REQUEST_MESSAGE
  REQUEST_STATUS
  REQUEST_ATTACHMENT
  REQUEST_ARCHIVE
  CONTENT_RISK
}

enum EventType {
  PROJECT_UPDATED
  PROJECT_UPDATE_CREATED
  UPDATE_COMMENT_CREATED
  REQUEST_CREATED
  REQUEST_ASSIGNED
  REQUEST_MESSAGE_CREATED
  REQUEST_STATUS_CHANGED
  REQUEST_UPDATED
  REQUEST_PRESENCE_CHANGED
  PLUGIN_RUN_UPDATED
  NOTIFICATION_CREATED
  CONTENT_RISK_DETECTED
  CONTENT_RISK_REVIEW_UPDATED
  CONTENT_RISK_PLUGIN_FAILED
}

enum ContentRiskTargetType {
  SERVICE_REQUEST
  REQUEST_MESSAGE
  PROJECT_UPDATE
  UPDATE_COMMENT
  MILESTONE
  MILESTONE_COMMENT
  ATTACHMENT
}

enum ContentRiskReviewStatus {
  QUEUED
  PROCESSING
  PASSED
  VIOLATION
  UNCERTAIN
  SKIPPED_UNSUPPORTED
  CANCELLED
  FAILED
}

enum ContentRiskDecisionSource {
  RULE
  AI
  ADMIN
}

enum ContentRiskDisplayState {
  VISIBLE
  REVOKED
}

enum MailDeliveryMode {
  LOCAL_OUTBOX
  RESEND
  SMTP
}

enum MailMessageStatus {
  QUEUED
  PROCESSING
  SENT
  DELIVERY_DELAYED
  DELIVERED
  BOUNCED
  COMPLAINED
  SUPPRESSED
  FAILED
  CANCELLED
}

enum UserEmailChangeStatus {
  PENDING
  COMPLETING
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PluginRunStatus {
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum PluginResourceStatus {
  PROCESSING
  COMPLETED
  SKIPPED
  FAILED
}

enum ProjectPluginBindingStatus {
  DRAFT
  ACTIVE
  DISABLED
  ARCHIVED
}

enum ExternalContactStatus {
  ACTIVE
  BLOCKED
}

enum UniversalWebhookDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum SupportPlaybookCategory {
  REMOTE
  DIAGNOSTIC
  INFORMATION
}

model User {
  id                               String            @id @default(cuid())
  name                             String
  email                            String            @unique
  emailVerified                    Boolean           @default(false)
  image                            String?
  platformRole                     PlatformRole      @default(CUSTOMER)
  phone                            String?
  company                          String?
  jobTitle                         String?
  wechat                           String?
  website                          String?
  location                         String?
  contactNotes                     String?
  roleGroupId                      String?
  soundNotificationsEnabled        Boolean           @default(true)
  requestEmailNotificationsEnabled Boolean           @default(true)
  themePreference                  ThemePreference   @default(SYSTEM)
  deletedAt                        DateTime?
  createdAt                        DateTime          @default(now())
  platformSettingsUpdated          PlatformSetting[] @relation("PlatformSettingUpdater")
  updatedAt                        DateTime          @updatedAt

  roleGroup                  RoleGroup?                   @relation(fields: [roleGroupId], references: [id], onDelete: SetNull)
  sessions                   Session[]
  accounts                   Account[]
  memberships                Membership[]
  ownedSpaces                CustomerSpace[]              @relation("SpaceOwner")
  invitationsCreated         Invitation[]                 @relation("InvitationCreator")
  staffInvitationsCreated    StaffInvitation[]            @relation("StaffInvitationCreator")
  projectsCreated            Project[]                    @relation("ProjectCreator")
  projectAssignments         ProjectStaff[]
  milestonesCreated          Milestone[]                  @relation("MilestoneCreator")
  milestoneComments          MilestoneComment[]
  projectUpdates             ProjectUpdate[]
  updateComments             UpdateComment[]
  projectUpdateRevisions     ProjectUpdateRevision[]      @relation("ProjectUpdateRevisionEditor")
  updateCommentRevisions     UpdateCommentRevision[]      @relation("UpdateCommentRevisionEditor")
  requestsCreated            ServiceRequest[]             @relation("RequestCreator")
  requestsAssigned           ServiceRequest[]             @relation("RequestAssignee")
  requestAssignees           RequestAssignee[]
  requestMessages            RequestMessage[]
  requestPresences           RequestPresence[]
  attachments                Attachment[]
  notifications              Notification[]
  auditLogs                  AuditLog[]
  mailTemplatesUpdated       MailTemplateOverride[]
  supportPlaybooksUpdated    SupportPlaybook[]            @relation("SupportPlaybookUpdater")
  notificationRulesUpdated   NotificationDeliveryRule[]   @relation("NotificationDeliveryRuleUpdater")
  emailChanges               UserEmailChange[]            @relation("EmailChangeUser")
  emailChangesRequested      UserEmailChange[]            @relation("EmailChangeRequester")
  pluginInstallationsUpdated PluginInstallation[]         @relation("PluginInstallationUpdater")
  pluginRunsRequested        PluginRun[]                  @relation("PluginRunRequester")
  notificationPreferences    UserNotificationPreference[]
  wechatBinding              WechatBinding?
  wechatBindingCodes         WechatBindingCode[]
  wechatBindingCodesCreated  WechatBindingCode[]          @relation("WechatBindingCodeCreator")
  miniappSessions            MiniappSession[]
  wechatSubscribeGrants      WechatSubscribeGrant[]

  @@index([roleGroupId])
  @@index([deletedAt, platformRole])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// 微信小程序：微信身份与客户账号的当前有效绑定（一对一）。
// 解绑即删除记录、历史通过 AuditLog 留存，避免占用 openid/userId 唯一键。
model WechatBinding {
  id          String    @id @default(cuid())
  userId      String    @unique
  openid      String    @unique
  unionid     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 微信小程序：管理员签发的一次性绑定码（仅保存哈希，明文只在生成时返回一次）。
model WechatBindingCode {
  id           String    @id @default(cuid())
  userId       String
  codeHash     String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  usedByOpenid String?
  createdById  String
  createdAt    DateTime  @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy User @relation("WechatBindingCodeCreator", fields: [createdById], references: [id])

  @@index([userId, createdAt])
}

// 微信小程序会话：Bearer token 仅存哈希，与 better-auth Session 分离。
model MiniappSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

// 微信小程序：code2Session 成功但尚未绑定的待绑定票据（短时效、单次使用）。
model MiniappAuthTicket {
  id           String    @id @default(cuid())
  ticketHash   String    @unique
  openid       String
  unionid      String?
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())
  otpSentCount Int       @default(0)

  @@index([openid, createdAt])
}

// 网页版扫码登录：Web 生成二维码票据，小程序扫码确认后换取 better-auth 会话。
model WebQrLoginTicket {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  status      String    @default("PENDING") // PENDING | CONFIRMED | CONSUMED | EXPIRED
  userId      String?
  expiresAt   DateTime
  confirmedAt DateTime?
  consumedAt  DateTime?
  // 创建票据浏览器的绑定 cookie 哈希（防登录 CSRF：票据被诱导到他人浏览器时轮询被拒）
  bindHash    String?
  // 已消费票据的一次性重签标记（轮询响应丢失时最多补签一次）
  reissuedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
}

// 微信小程序：按 openid 的绑定尝试防暴力计数与锁定。
model WechatBindGuard {
  openid      String    @id
  failCount   Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// 微信订阅消息授权额度：客户端上报仅作状态参考，发送前服务端校验并按微信实际结果修正。
model WechatSubscribeGrant {
  id             String    @id @default(cuid())
  userId         String
  templateKey    String
  remaining      Int       @default(0)
  updatedAt      DateTime  @updatedAt
  lastReportedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, templateKey])
}

model CustomerSpace {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  kind        CustomerSpaceKind @default(STANDARD)
  memberLimit Int               @default(2)
  status      SpaceStatus       @default(ACTIVE)
  ownerId     String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  owner         User           @relation("SpaceOwner", fields: [ownerId], references: [id])
  memberships   Membership[]
  invitations   Invitation[]
  projects      Project[]
  attachments   Attachment[]
  notifications Notification[]
  auditLogs     AuditLog[]
  events        EventRecord[]

  @@index([ownerId])
  @@index([kind, status])
}

model Membership {
  id              String          @id @default(cuid())
  customerSpaceId String
  userId          String
  role            SpaceMemberRole @default(MEMBER)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  customerSpace CustomerSpace @relation(fields: [customerSpaceId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([customerSpaceId, userId])
  @@index([userId])
}

model Invitation {
  id              String          @id @default(cuid())
  email           String
  tokenHash       String          @unique
  role            SpaceMemberRole @default(MEMBER)
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  customerSpaceId String
  invitedById     String
  createdAt       DateTime        @default(now())

  customerSpace CustomerSpace @relation(fields: [customerSpaceId], references: [id], onDelete: Cascade)
  invitedBy     User          @relation("InvitationCreator", fields: [invitedById], references: [id])

  @@index([email])
  @@index([customerSpaceId])
}

model StaffInvitation {
  id           String       @id @default(cuid())
  email        String
  name         String?
  phone        String?
  company      String?
  jobTitle     String?
  wechat       String?
  website      String?
  location     String?
  contactNotes String?
  tokenHash    String       @unique
  platformRole PlatformRole
  roleGroupId  String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  invitedById  String
  createdAt    DateTime     @default(now())

  invitedBy User       @relation("StaffInvitationCreator", fields: [invitedById], references: [id])
  roleGroup RoleGroup? @relation(fields: [roleGroupId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([platformRole, createdAt])
  @@index([roleGroupId])
}

model RoleGroup {
  id          String          @id @default(cuid())
  key         String          @unique
  name        String
  description String?
  accessLevel RoleAccessLevel
  permissions String[]
  isSystem    Boolean         @default(false)
  active      Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  users       User[]
  invitations StaffInvitation[]

  @@index([active, sortOrder])
}

model ServiceType {
  id                   String   @id @default(cuid())
  key                  String   @unique
  name                 String
  description          String?
  active               Boolean  @default(true)
  slaResponseMinutes   Int?
  slaResolutionMinutes Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  requestCategories RequestCategory[]
  projects          Project[]
}

model RequestCategory {
  id            String   @id @default(cuid())
  name          String
  description   String?
  active        Boolean  @default(true)
  serviceTypeId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  serviceType ServiceType      @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  requests    ServiceRequest[]

  @@unique([serviceTypeId, name])
}

model Project {
  id                      String        @id @default(cuid())
  title                   String
  description             String?
  status                  ProjectStatus @default(ACTIVE)
  kind                    ProjectKind   @default(STANDARD)
  currentStage            String?
  showMilestones          Boolean       @default(true)
  showProgress            Boolean       @default(true)
  customerUpdatesEnabled  Boolean       @default(true)
  customerRequestsEnabled Boolean       @default(true)
  customerFilesEnabled    Boolean       @default(true)
  startDate               DateTime?
  endDate                 DateTime?
  customerSpaceId         String
  serviceTypeId           String
  createdById             String
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  customerSpace  CustomerSpace          @relation(fields: [customerSpaceId], references: [id], onDelete: Cascade)
  serviceType    ServiceType            @relation(fields: [serviceTypeId], references: [id])
  createdBy      User                   @relation("ProjectCreator", fields: [createdById], references: [id])
  staff          ProjectStaff[]
  milestones     Milestone[]
  updates        ProjectUpdate[]
  requests       ServiceRequest[]
  attachments    Attachment[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  events         EventRecord[]
  pluginBindings ProjectPluginBinding[]

  @@index([customerSpaceId, status])
  @@index([serviceTypeId])
}

model ProjectStaff {
  id        String           @id @default(cuid())
  projectId String
  userId    String
  role      ProjectStaffRole
  createdAt DateTime         @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, role])
}

model Milestone {
  id          String          @id @default(cuid())
  title       String
  description String?
  status      MilestoneStatus @default(NOT_STARTED)
  startDate   DateTime?
  endDate     DateTime?
  sortOrder   Int             @default(0)
  projectId   String
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("MilestoneCreator", fields: [createdById], references: [id])
  attachments Attachment[]
  comments    MilestoneComment[]

  @@index([projectId, sortOrder])
}

model MilestoneComment {
  id          String            @id @default(cuid())
  body        String
  visibility  ContentVisibility @default(CUSTOMER_VISIBLE)
  milestoneId String
  authorId    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  milestone   Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id])
  attachments Attachment[]

  @@index([milestoneId, createdAt])
}

model ProjectUpdate {
  id         String            @id @default(cuid())
  title      String
  body       String
  visibility ContentVisibility @default(CUSTOMER_VISIBLE)
  projectId  String
  authorId   String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User                    @relation(fields: [authorId], references: [id])
  comments    UpdateComment[]
  revisions   ProjectUpdateRevision[]
  attachments Attachment[]

  @@index([projectId, createdAt])
}

model UpdateComment {
  id              String            @id @default(cuid())
  body            String
  visibility      ContentVisibility @default(CUSTOMER_VISIBLE)
  projectUpdateId String
  authorId        String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  projectUpdate ProjectUpdate           @relation(fields: [projectUpdateId], references: [id], onDelete: Cascade)
  author        User                    @relation(fields: [authorId], references: [id])
  revisions     UpdateCommentRevision[]
  attachments   Attachment[]

  @@index([projectUpdateId, createdAt])
}

model ProjectUpdateRevision {
  id              String            @id @default(cuid())
  projectUpdateId String
  title           String
  body            String
  visibility      ContentVisibility
  editedAt        DateTime          @default(now())
  editedById      String

  projectUpdate ProjectUpdate @relation(fields: [projectUpdateId], references: [id], onDelete: Cascade)
  editedBy      User          @relation("ProjectUpdateRevisionEditor", fields: [editedById], references: [id])

  @@index([projectUpdateId, editedAt])
}

model UpdateCommentRevision {
  id              String            @id @default(cuid())
  updateCommentId String
  body            String
  visibility      ContentVisibility
  editedAt        DateTime          @default(now())
  editedById      String

  updateComment UpdateComment @relation(fields: [updateCommentId], references: [id], onDelete: Cascade)
  editedBy      User          @relation("UpdateCommentRevisionEditor", fields: [editedById], references: [id])

  @@index([updateCommentId, editedAt])
}

model ServiceRequest {
  id                         String          @id @default(cuid())
  number                     String          @unique
  title                      String
  description                String
  priority                   RequestPriority @default(NORMAL)
  status                     RequestStatus   @default(PENDING)
  projectId                  String
  categoryId                 String
  createdById                String?
  createdByExternalContactId String?
  assigneeId                 String?
  clientMutationKey          String?
  firstRespondedAt           DateTime?
  dueAt                      DateTime?
  resolvedAt                 DateTime?
  closedAt                   DateTime?
  archivedAt                 DateTime?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  project                  Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category                 RequestCategory            @relation(fields: [categoryId], references: [id])
  createdBy                User?                      @relation("RequestCreator", fields: [createdById], references: [id])
  createdByExternalContact ExternalContact?           @relation("ExternalRequestCreator", fields: [createdByExternalContactId], references: [id])
  assignee                 User?                      @relation("RequestAssignee", fields: [assigneeId], references: [id])
  assignees                RequestAssignee[]
  messages                 RequestMessage[]
  presences                RequestPresence[]
  externalPresences        ExternalRequestPresence[]
  externalReadStates       ExternalRequestReadState[]
  attachments              Attachment[]
  notifications            Notification[]
  auditLogs                AuditLog[]
  events                   EventRecord[]
  dingTalkRobotDeliveries  DingTalkRobotDelivery[]

  @@unique([createdById, clientMutationKey])
  @@index([projectId, status])
  @@index([projectId, archivedAt, status])
  @@index([assigneeId, status])
  @@index([dueAt])
  @@index([status, resolvedAt])
  @@index([createdByExternalContactId, createdAt])
}

model RequestAssignee {
  id               String   @id @default(cuid())
  serviceRequestId String
  userId           String
  assignedAt       DateTime @default(now())
  assignedById     String?

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serviceRequestId, userId])
  @@index([userId])
  @@index([serviceRequestId])
}

model RequestMessage {
  id                      String            @id @default(cuid())
  body                    String
  visibility              ContentVisibility @default(CUSTOMER_VISIBLE)
  isSystem                Boolean           @default(false)
  isInitial               Boolean           @default(false)
  serviceRequestId        String
  authorId                String?
  externalAuthorId        String?
  replyToMessageId        String?
  clientMutationKey       String?
  supportPlaybookKey      String?
  supportPlaybookSnapshot Json?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  serviceRequest ServiceRequest   @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  author         User?            @relation(fields: [authorId], references: [id])
  externalAuthor ExternalContact? @relation(fields: [externalAuthorId], references: [id])
  replyTo        RequestMessage?  @relation("RequestMessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies        RequestMessage[] @relation("RequestMessageReplies")
  attachments    Attachment[]

  @@unique([authorId, clientMutationKey])
  @@index([serviceRequestId, createdAt])
  @@index([replyToMessageId])
  @@index([externalAuthorId, createdAt])
}

// Office 附件的 PDF 预览件生成状态；null = 该类型无需转换
enum AttachmentPreviewStatus {
  PENDING
  READY
  FAILED
}

model Attachment {
  id                          String                   @id @default(cuid())
  originalName                String
  title                       String?
  note                        String?
  storageKey                  String                   @unique
  previewStorageKey           String?
  previewStatus               AttachmentPreviewStatus?
  mimeType                    String
  size                        Int
  visibility                  ContentVisibility        @default(CUSTOMER_VISIBLE)
  inline                      Boolean                  @default(false)
  customerSpaceId             String?
  projectId                   String?
  projectUpdateId             String?
  updateCommentId             String?
  milestoneId                 String?
  supportPlaybookKey          String?
  serviceRequestId            String?
  requestMessageId            String?
  uploadedById                String?
  uploadedByExternalContactId String?
  createdAt                   DateTime                 @default(now())
  /// 显式「添加到项目文件」：非空表示已收录进项目文件列表。
  /// 不改动 serviceRequestId 等归属字段 —— RLS 仍按原归属裁决可见性，
  /// 看不到源工单的人即使文件被收录也读不到。
  pinnedToProjectAt           DateTime?
  pinnedById                  String?

  customerSpace             CustomerSpace?    @relation(fields: [customerSpaceId], references: [id], onDelete: Cascade)
  project                   Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectUpdate             ProjectUpdate?    @relation(fields: [projectUpdateId], references: [id], onDelete: Cascade)
  updateComment             UpdateComment?    @relation(fields: [updateCommentId], references: [id], onDelete: Cascade)
  milestone                 Milestone?        @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  supportPlaybook           SupportPlaybook?  @relation(fields: [supportPlaybookKey], references: [key], onDelete: SetNull)
  serviceRequest            ServiceRequest?   @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  requestMessage            RequestMessage?   @relation(fields: [requestMessageId], references: [id], onDelete: Cascade)
  uploadedBy                User?             @relation(fields: [uploadedById], references: [id])
  uploadedByExternalContact ExternalContact?  @relation(fields: [uploadedByExternalContactId], references: [id])
