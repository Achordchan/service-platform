model ExternalContact {
  id                String                @id @default(cuid())
  bindingId         String
  externalUserId    String
  email             String?
  username          String?
  displayName       String
  avatarUrl         String?
  profileAttributes Json                  @default("{}")
  lastParentOrigin  String?
  status            ExternalContactStatus @default(ACTIVE)
  firstSeenAt       DateTime              @default(now())
  lastSeenAt        DateTime              @default(now())
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  binding           ProjectPluginBinding       @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  embedSessions     ExternalEmbedSession[]
  requestsCreated   ServiceRequest[]           @relation("ExternalRequestCreator")
  requestMessages   RequestMessage[]
  attachments       Attachment[]
  requestPresences  ExternalRequestPresence[]
